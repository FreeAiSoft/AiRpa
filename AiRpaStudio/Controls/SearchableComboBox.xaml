<UserControl x:Class="RPA.Controls.SearchableComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RPA.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="40" d:DesignWidth="300">
    
    <UserControl.Resources>
        <!-- Стиль для элементов списка -->
        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DropShadow эффект для Popup -->
        <DropShadowEffect x:Key="DropShadowEffect" 
                         BlurRadius="10" 
                         ShadowDepth="2" 
                         Opacity="0.3" 
                         Color="Black"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- Кнопка выбора с выбранным значением -->
        <Border x:Name="SelectionButton"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Cursor="Hand"
                MouseDown="SelectionButton_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Выбранное значение или placeholder -->
                <TextBlock Grid.Column="0"
                          Padding="12,8"
                          FontSize="13"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                    <Setter Property="Text" Value="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
                <!-- Иконка dropdown -->
                <Border Grid.Column="1"
                        Padding="8"
                        Background="Transparent">
                    <materialIcons:MaterialIcon Kind="ChevronDown"
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Foreground="#666666" />
                </Border>
            </Grid>
        </Border>
        
        <!-- Popup с поиском и результатами -->
        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=SelectionButton}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="True"
               Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
               MaxHeight="350">
            <Border Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="4"
                    Effect="{StaticResource DropShadowEffect}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Поле поиска внутри popup -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Иконка поиска -->
                        <Border Grid.Column="0"
                                Background="Transparent"
                                Padding="8,8,4,8">
                            <materialIcons:MaterialIcon Kind="Magnify"
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Center"
                                                        Foreground="#666666" />
                        </Border>
                        
                        <!-- Поле ввода поиска -->
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="4,8,8,8"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Foreground="#999999"
                                                              Padding="4,8,8,8"
                                                              FontSize="13"
                                                              VerticalAlignment="Center"
                                                              IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    
                    <!-- Разделитель -->
                    <Border Grid.Row="0"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1"
                            VerticalAlignment="Bottom"/>
                    
                    <!-- Список результатов -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ResultsListBox"
                                 ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 BorderThickness="0"
                                 MaxHeight="280"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                 SelectionChanged="ResultsListBox_SelectionChanged"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                              TextTrimming="CharacterEllipsis"
                                              FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Сообщение "Ничего не найдено" -->
                        <TextBlock Text="Ничего не найдено"
                                  FontSize="13"
                                  Foreground="#999999"
                                  Padding="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredItems.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>