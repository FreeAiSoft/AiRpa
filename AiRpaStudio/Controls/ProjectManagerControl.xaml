<UserControl x:Class="RPA.Controls.ProjectManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RPA.Controls"
             xmlns:enums="clr-namespace:RPA.Enums"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:converters="clr-namespace:RPA.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:MultiConverter x:Key="MultiConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:FileExtensionConverter x:Key="FileExtensionConverter" />
        
        <!-- Контекстное меню для TextBox с стандартными командами, но без фокуса -->
        <ContextMenu x:Key="TextBoxContextMenu" Focusable="False">
            <MenuItem Header="Вырезать"
                      Command="ApplicationCommands.Cut"
                      Focusable="False"/>
            <MenuItem Header="Копировать"
                      Command="ApplicationCommands.Copy"
                      Focusable="False"/>
            <MenuItem Header="Вставить"
                      Command="ApplicationCommands.Paste"
                      Focusable="False"/>
            <Separator/>
            <MenuItem Header="Выделить всё"
                      Command="ApplicationCommands.SelectAll"
                      Focusable="False"/>
        </ContextMenu>
        
        <ContextMenu x:Key="ProjectContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Добавить активность"
                      x:Name="AddActivity"
                      Command="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext.Cmd}"
                      CommandParameter="CmdAddNewActivityToProject"
                      Focusable="False" />
            <MenuItem Header="Добавить папку"
                      x:Name="AddFolder"
                      Click="AddFolder_Click"
                      Focusable="False"/>
            <MenuItem Header="Переименовать проект"
                      x:Name="RenameProj"
                      Click="Rename_Click"
                      Focusable="False"/>
            <MenuItem Header="Добавить зависимость"
                      IsEnabled="False"
                      x:Name="AddRefence"
                      Click="AddRefence_Click"
                      Focusable="False"/>
        </ContextMenu>
        <ContextMenu x:Key="ProjectFileContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Открыть"
                      x:Name="OpenFileMenuItem"
                      Click="OpenFileMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="Открыть в редакторе кода"
                      x:Name="OpenInCodeEditorMenuItem"
                      Click="OpenInCodeEditorMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="{DynamicResource lang_cm_open_in_vs}"
                      x:Name="OpenInVsMenuItem"
                      Click="OpenInVsMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="{DynamicResource lang_cm_build_msbuild}"
                      x:Name="BuildWithMsBuildMenuItem"
                      Click="BuildWithMsBuildMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="Удалить файл"
                      x:Name="DeleteFileMenuItem"
                      Click="DeleteFileMenuItem_Click"
                      Focusable="False" />
            <MenuItem Header="Переименовать"
                      x:Name="RenameFileMenuItem"
                      Click="Rename_Click"
                      Focusable="False"/>
            <MenuItem Header="Открыть содержащую папку"
                      x:Name="OpenFolderContainingFileMenuItem"
                      Click="OpenFolderContainingFileMenuItem_Click"
                      Focusable="False"/>
        </ContextMenu>
        <ContextMenu x:Key="ProjectFolderContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Переименовать"
                      x:Name="RenameFolderMenuItem"
                      Click="Rename_Click"
                      Focusable="False"/>
            <MenuItem Header="Удалить"
                      x:Name="DeleteFolderMenuItem"
                      Click="DeleteFolderMenuItem_Click"
                      Focusable="False"/>
            <Separator/>
            <MenuItem Header="Добавить папку"
                      x:Name="AddFolderToFolderMenuItem"
                      Click="AddFolderToFolderMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="Добавить активность"
                      x:Name="AddActivityToFolderMenuItem"
                      Click="AddActivityToFolderMenuItem_Click"
                      Focusable="False"/>
        </ContextMenu>
        <ContextMenu x:Key="VsProjectContext" Focusable="False">
            <MenuItem Header="Открыть в редакторе кода"
                      x:Name="SolutionOpenInCodeEditorMenuItem"
                      Click="OpenInCodeEditorMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="{DynamicResource lang_cm_open_in_vs}"
                      Click="OpenInVsMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="{DynamicResource lang_cm_build_msbuild}"
                      Click="BuildWithMsBuildMenuItem_Click"
                      Focusable="False"/>
        </ContextMenu>

        <!-- Контекстное меню основного файла проекта Visual Studio (.csproj): те же действия, что и у
             нативного проекта студии (project.json) — создать активность и папку, переименовать проект,
             добавить зависимость. Имена пунктов отличаются от файлового меню намеренно: ContextMenu_Opened
             по именам решает, что скрывать, и не должен прятать «Открыть в VS» у корня проекта.
             Правило видимости этих имён — ProjectTreeMenuRules; «Открыть в редакторе кода» назван
             отдельным именем по той же причине. -->
        <ContextMenu x:Key="VsProjectRootContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Добавить активность"
                      x:Name="VsAddActivityMenuItem"
                      Click="AddActivityToVsProjectMenuItem_Click"
                      Focusable="False" />
            <MenuItem Header="Добавить папку проекта"
                      x:Name="VsAddFolderMenuItem"
                      Click="AddFolder_Click"
                      Focusable="False" />
            <MenuItem Header="Переименовать проект"
                      x:Name="VsRenameProjectMenuItem"
                      Click="Rename_Click"
                      Focusable="False" />
            <MenuItem Header="Добавить зависимость"
                      x:Name="VsAddDependencyMenuItem"
                      Click="AddDependencyToVsProjectMenuItem_Click"
                      Focusable="False" />
            <Separator />
            <MenuItem Header="Открыть в редакторе кода"
                      x:Name="VsRootOpenInCodeEditorMenuItem"
                      Click="OpenInCodeEditorMenuItem_Click"
                      Focusable="False" />
            <MenuItem Header="{DynamicResource lang_cm_open_in_vs}"
                      x:Name="VsRootOpenInVsMenuItem"
                      Click="OpenInVsMenuItem_Click"
                      Focusable="False" />
            <MenuItem Header="{DynamicResource lang_cm_build_msbuild}"
                      x:Name="VsRootBuildWithMsBuildMenuItem"
                      Click="BuildWithMsBuildMenuItem_Click"
                      Focusable="False" />
        </ContextMenu>
        
        <!-- Стиль для обычных кнопок в стиле toggle -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="BorderThickness"
                    Value="1,1,0,1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.ToolbarBorder}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarPressedBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для последней обычной кнопки -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonLastStyle"
               BasedOn="{StaticResource LogLevelButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1,1,1,1" />
        </Style>
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Margin="5">
                <Button x:Name="ExpandButton"
                        Click="ExpandButton_Click"
                        ToolTip="Развернуть"
                        Style="{StaticResource LogLevelButtonStyle}">
                    <materialIcons:MaterialIcon Kind="Add"
                                                Width="18"
                                                Height="18" />
                </Button>
                <Button x:Name="CollapseButton"
                        Click="CollapseButton_Click"
                        ToolTip="Свернуть"
                        Style="{StaticResource LogLevelButtonStyle}">
                    <materialIcons:MaterialIcon Kind="Minus"
                                                Width="18"
                                                Height="18" />
                </Button>
                <Button x:Name="OpenProjectFolderButton"
                        Click="OpenProjectFolderButton_Click"
                        ToolTip="Свернуть"
                        Style="{StaticResource LogLevelButtonLastStyle}">
                    <materialIcons:MaterialIcon Kind="FolderOpenOutline"
                                                Width="18"
                                                Height="18" />
                </Button>
            </StackPanel>
            <TextBox Grid.Column="1"
                     Background="{DynamicResource Studio.Surface}"
                     Foreground="{DynamicResource Studio.Foreground}"
                     BorderBrush="{DynamicResource Studio.Separator}"
                     CaretBrush="{DynamicResource Studio.Foreground}"
                     FontFamily="{DynamicResource Studio.FontFamily}"
                     Margin="5" />
        </Grid>

        <TreeView x:Name="projectTree"
                  Margin="5"
                  Background="{DynamicResource Studio.Surface}"
                  Foreground="{DynamicResource Studio.Foreground}"
                  BorderBrush="{DynamicResource Studio.Separator}"
                  FontFamily="{DynamicResource Studio.FontFamily}"
                  Grid.Row="1"
                  ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <!-- Текст названия файла: без явных кистей он приходил из системных (чёрный на тёмном
                         фоне после выбора элемента). Состояния — яркостью палитры студии. -->
                    <Setter Property="Foreground"
                            Value="{DynamicResource Studio.Foreground}" />
                    <Setter Property="Background"
                            Value="Transparent" />
                    <Setter Property="FontFamily"
                            Value="{DynamicResource Studio.FontFamily}" />
                    <Setter Property="IsExpanded"
                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <EventSetter Event="PreviewMouseRightButtonDown"
                                 Handler="TreeViewItem_PreviewMouseRightButtonDown" />
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource Studio.Hover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Studio.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource Studio.Selected}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Studio.Foreground}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Path=Childs}">
                    <Grid Tag="{Binding Path=.}"
                          Background="Transparent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.File}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource ProjectFileContext}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.Project}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource ProjectContext}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.Dir}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource ProjectFolderContext}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.Solution}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource VsProjectContext}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.VsProject}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource VsProjectRootContext}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- StackPanel для обычного отображения с иконкой -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            
                            <!-- Иконка папки -->
                            <materialIcons:MaterialIcon Kind="FolderOpenOutline"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="{DynamicResource Studio.Semantic.FolderIcon}"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon.Style>
                                    <Style TargetType="materialIcons:MaterialIcon">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FSNodeType}"
                                                         Value="{x:Static enums:FSNodeType.Dir}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialIcons:MaterialIcon.Style>
                            </materialIcons:MaterialIcon>

                            <!-- Иконка для .xaml файлов -->
                            <materialIcons:MaterialIcon Kind="Xml"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="{DynamicResource Studio.Semantic.XamlFileIcon}"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon.Style>
                                    <Style TargetType="materialIcons:MaterialIcon">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FSNodeType}"
                                                               Value="{x:Static enums:FSNodeType.File}" />
                                                    <Condition Binding="{Binding Name, Converter={StaticResource FileExtensionConverter}, ConverterParameter='.xaml'}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialIcons:MaterialIcon.Style>
                            </materialIcons:MaterialIcon>

                            <!-- Иконка для .json файлов -->
                            <materialIcons:MaterialIcon Kind="CodeJson"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="{DynamicResource Studio.Semantic.JsonFileIcon}"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon.Style>
                                    <Style TargetType="materialIcons:MaterialIcon">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FSNodeType}"
                                                               Value="{x:Static enums:FSNodeType.File}" />
                                                    <Condition Binding="{Binding Name, Converter={StaticResource FileExtensionConverter}, ConverterParameter='.json'}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialIcons:MaterialIcon.Style>
                            </materialIcons:MaterialIcon>

                            <!-- TextBlock -->
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource Studio.Foreground}"
                                       FontFamily="{DynamicResource Studio.FontFamily}"
                                       ToolTip="{Binding RuntimeFullPath}"
                                       VerticalAlignment="Center"
                                       Tag="{Binding Path=.}"
                                       MouseLeftButtonDown="TextBlock_MouseDown" />
                        </StackPanel>

                        <!-- TextBox для режима редактирования -->
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Studio.Surface}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 BorderBrush="{DynamicResource Studio.SeparatorStrong}"
                                 CaretBrush="{DynamicResource Studio.Foreground}"
                                 FontFamily="{DynamicResource Studio.FontFamily}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Tag="{Binding Path=.}"
                                 KeyDown="EditTextBox_KeyDown"
                                 ContextMenu="{StaticResource TextBoxContextMenu}">
                            <i:Interaction.Behaviors>
                                <local:TextBoxFocusBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
