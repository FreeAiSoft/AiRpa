<UserControl x:Class="RPA.Controls.ProjectManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RPA.Controls"
             xmlns:enums="clr-namespace:RPA.Enums"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:converters="clr-namespace:RPA.Converters"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:MultiConverter x:Key="MultiConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:FileExtensionConverter x:Key="FileExtensionConverter" />
        
        <!-- Контекстное меню для TextBox с стандартными командами, но без фокуса -->
        <ContextMenu x:Key="TextBoxContextMenu" Focusable="False">
            <MenuItem Header="Вырезать"
                      Command="ApplicationCommands.Cut"
                      Focusable="False"/>
            <MenuItem Header="Копировать"
                      Command="ApplicationCommands.Copy"
                      Focusable="False"/>
            <MenuItem Header="Вставить"
                      Command="ApplicationCommands.Paste"
                      Focusable="False"/>
            <Separator/>
            <MenuItem Header="Выделить всё"
                      Command="ApplicationCommands.SelectAll"
                      Focusable="False"/>
        </ContextMenu>
        
        <ContextMenu x:Key="ProjectContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Добавить активность"
                      x:Name="AddActivity"
                      Command="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=DataContext.Cmd}"
                      CommandParameter="CmdAddNewActivityToProject"
                      Focusable="False" />
            <MenuItem Header="Добавить папку"
                      x:Name="AddFolder"
                      Click="AddFolder_Click"
                      Focusable="False"/>
            <MenuItem Header="Переименовать проект"
                      x:Name="RenameProj"
                      Click="Rename_Click"
                      Focusable="False"/>
            <MenuItem Header="Добавить зависимость"
                      IsEnabled="False"
                      x:Name="AddRefence"
                      Click="AddRefence_Click"
                      Focusable="False"/>
        </ContextMenu>
        <ContextMenu x:Key="ProjectFileContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Открыть"
                      x:Name="OpenFileMenuItem"
                      Click="OpenFileMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="Удалить файл"
                      x:Name="DeleteFileMenuItem"
                      Click="DeleteFileMenuItem_Click"
                      Focusable="False" />
            <MenuItem Header="Переименовать"
                      x:Name="RenameFileMenuItem"
                      Click="Rename_Click"
                      Focusable="False"/>
            <MenuItem Header="Открыть содержащую папку"
                      x:Name="OpenFolderContainingFileMenuItem"
                      Click="OpenFolderContainingFileMenuItem_Click"
                      Focusable="False"/>
        </ContextMenu>
        <ContextMenu x:Key="ProjectFolderContext" Opened="ContextMenu_Opened" Focusable="False">
            <MenuItem Header="Переименовать"
                      x:Name="RenameFolderMenuItem"
                      Click="Rename_Click"
                      Focusable="False"/>
            <MenuItem Header="Удалить"
                      x:Name="DeleteFolderMenuItem"
                      Click="DeleteFolderMenuItem_Click"
                      Focusable="False"/>
            <Separator/>
            <MenuItem Header="Добавить папку"
                      x:Name="AddFolderToFolderMenuItem"
                      Click="AddFolderToFolderMenuItem_Click"
                      Focusable="False"/>
            <MenuItem Header="Добавить активность"
                      x:Name="AddActivityToFolderMenuItem"
                      Click="AddActivityToFolderMenuItem_Click"
                      Focusable="False"/>
        </ContextMenu>
        
        <!-- Стиль для обычных кнопок в стиле toggle -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="BorderThickness"
                    Value="1,1,0,1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="#DDDDDD" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#F5F5F5" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E0E0E0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для последней обычной кнопки -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonLastStyle"
               BasedOn="{StaticResource LogLevelButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1,1,1,1" />
        </Style>
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Margin="5">
                <Button x:Name="ExpandButton"
                        Click="ExpandButton_Click"
                        ToolTip="Развернуть"
                        Style="{StaticResource LogLevelButtonStyle}">
                    <materialIcons:MaterialIcon Kind="Add"
                                                Width="18"
                                                Height="18" />
                </Button>
                <Button x:Name="CollapseButton"
                        Click="CollapseButton_Click"
                        ToolTip="Свернуть"
                        Style="{StaticResource LogLevelButtonStyle}">
                    <materialIcons:MaterialIcon Kind="Minus"
                                                Width="18"
                                                Height="18" />
                </Button>
                <Button x:Name="OpenProjectFolderButton"
                        Click="OpenProjectFolderButton_Click"
                        ToolTip="Свернуть"
                        Style="{StaticResource LogLevelButtonLastStyle}">
                    <materialIcons:MaterialIcon Kind="FolderOpenOutline"
                                                Width="18"
                                                Height="18" />
                </Button>
            </StackPanel>
            <TextBox Grid.Column="1"
                     Margin="5"
                     mah:TextBoxHelper.ButtonCommand="{Binding ControlButtonCommandWithParameter, Mode=OneWay}"
                     mah:TextBoxHelper.ButtonContent="M17.545,15.467l-3.779-3.779c0.57-0.935,0.898-2.035,0.898-3.21c0-3.417-2.961-6.377-6.378-6.377  C4.869,2.1,2.1,4.87,2.1,8.287c0,3.416,2.961,6.377,6.377,6.377c1.137,0,2.2-0.309,3.115-0.844l3.799,3.801  c0.372,0.371,0.975,0.371,1.346,0l0.943-0.943C18.051,16.307,17.916,15.838,17.545,15.467z M4.004,8.287  c0-2.366,1.917-4.283,4.282-4.283c2.366,0,4.474,2.107,4.474,4.474c0,2.365-1.918,4.283-4.283,4.283  C6.111,12.76,4.004,10.652,4.004,8.287z"
                     mah:TextBoxHelper.Watermark="Search something..."
                     Style="{DynamicResource MahApps.Styles.TextBox.Search}" />
        </Grid>

        <TreeView x:Name="projectTree"
                  Margin="5"
                  FontFamily="Consolas"
                  Grid.Row="1"
                  ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}"
                       BasedOn="{StaticResource MahApps.Styles.TreeViewItem}">
                    <Setter Property="IsExpanded"
                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <EventSetter Event="PreviewMouseRightButtonDown"
                                 Handler="TreeViewItem_PreviewMouseRightButtonDown" />
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Path=Childs}">
                    <Grid Tag="{Binding Path=.}"
                          Background="Transparent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.File}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource ProjectFileContext}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.Project}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource ProjectContext}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FSNodeType}"
                                                 Value="{x:Static enums:FSNodeType.Dir}">
                                        <Setter Property="ContextMenu"
                                                Value="{StaticResource ProjectFolderContext}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- StackPanel для обычного отображения с иконкой -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            
                            <!-- Иконка папки -->
                            <materialIcons:MaterialIcon Kind="FolderOpenOutline"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="OrangeRed"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon.Style>
                                    <Style TargetType="materialIcons:MaterialIcon">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FSNodeType}"
                                                         Value="{x:Static enums:FSNodeType.Dir}">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialIcons:MaterialIcon.Style>
                            </materialIcons:MaterialIcon>

                            <!-- Иконка для .xaml файлов -->
                            <materialIcons:MaterialIcon Kind="Xml"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="DarkGreen"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon.Style>
                                    <Style TargetType="materialIcons:MaterialIcon">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FSNodeType}"
                                                               Value="{x:Static enums:FSNodeType.File}" />
                                                    <Condition Binding="{Binding Name, Converter={StaticResource FileExtensionConverter}, ConverterParameter='.xaml'}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialIcons:MaterialIcon.Style>
                            </materialIcons:MaterialIcon>

                            <!-- Иконка для .json файлов -->
                            <materialIcons:MaterialIcon Kind="CodeJson"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="DarkBlue"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon.Style>
                                    <Style TargetType="materialIcons:MaterialIcon">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FSNodeType}"
                                                               Value="{x:Static enums:FSNodeType.File}" />
                                                    <Condition Binding="{Binding Name, Converter={StaticResource FileExtensionConverter}, ConverterParameter='.json'}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialIcons:MaterialIcon.Style>
                            </materialIcons:MaterialIcon>

                            <!-- TextBlock -->
                            <TextBlock Text="{Binding Name}"
                                       ToolTip="{Binding RuntimeFullPath}"
                                       VerticalAlignment="Center"
                                       Tag="{Binding Path=.}"
                                       MouseLeftButtonDown="TextBlock_MouseDown" />
                        </StackPanel>

                        <!-- TextBox для режима редактирования -->
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Tag="{Binding Path=.}"
                                 KeyDown="EditTextBox_KeyDown"
                                 ContextMenu="{StaticResource TextBoxContextMenu}">
                            <i:Interaction.Behaviors>
                                <local:TextBoxFocusBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
