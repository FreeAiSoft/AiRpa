<UserControl x:Class="RPA.Controls.StudioTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RPA.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             FontFamily="{DynamicResource Studio.FontFamily}"
             mc:Ignorable="d"
             x:Name="Root"
             Height="32"
             d:DesignHeight="32"
             d:DesignWidth="450">
    <!--
        Полоса заголовка окон студии. Повторяет полосу главного окна (Views\MainView.xaml, строка 32px):
        высота 32, фон Studio.TitleBarBackground (= Surface), кнопки 46×32 на MaterialIcon, перетаскивание DragMove().
        Заголовок берётся из Title окна-владельца, поэтому контрол не требует DataContext и работает
        в окне ошибки, которое создаётся из обработчика падения приложения.
        Цвета — только ключи палитры: в оффлайн-пути ErrorDialog палитра подкладывается в Resources окна,
        и DynamicResource находит её по дереву выше Application.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="Button"
               x:Key="StudioTitleBarButtonStyle">
            <Setter Property="Width"
                    Value="46" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Studio.TitleBarForeground}" />
            <Setter Property="TextElement.Foreground"
                    Value="{DynamicResource Studio.TitleBarForeground}" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.TitleBarButtonHoverBackground}" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button"
               x:Key="StudioTitleBarCloseButtonStyle"
               BasedOn="{StaticResource StudioTitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.CloseHoverBackground}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Studio.CloseHoverForeground}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{DynamicResource Studio.CloseHoverForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Studio.TitleBarBackground}"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Studio.TitleBarForeground}"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0,0,5,0">
            <Button x:Name="MinimizeButton"
                    ToolTip="Minimize"
                    Style="{StaticResource StudioTitleBarButtonStyle}"
                    Visibility="{Binding ShowMinimize, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="Minimize_Click">
                <materialIcons:MaterialIcon Kind="WindowMinimize"
                                            Width="16"
                                            Height="16" />
            </Button>
            <Button x:Name="CloseButton"
                    ToolTip="Close"
                    Style="{StaticResource StudioTitleBarCloseButtonStyle}"
                    Visibility="{Binding ShowClose, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="Close_Click">
                <materialIcons:MaterialIcon Kind="WindowClose"
                                            Width="16"
                                            Height="16" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
