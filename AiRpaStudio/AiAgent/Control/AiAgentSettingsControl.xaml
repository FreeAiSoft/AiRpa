<UserControl x:Class="RPA.AiAgent.Control.AiAgentSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:controls="clr-namespace:RPA.Controls"
             xmlns:local="clr-namespace:RPA.AiAgent.Control"
             xmlns:converters="clr-namespace:RPA.AiAgent.Converters"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="600">
    
    <UserControl.Resources>
        <converters:ProviderTypeToVisibilityConverter x:Key="ProviderTypeToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Border Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Настройки"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Закрыть">
                    <materialIcons:MaterialIcon Kind="Close"
                                                Width="20"
                                                Height="20"/>
                </Button>
            </Grid>

            <!-- Содержимое настроек -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- Выбор провайдера -->
                    <StackPanel Margin="10">
                        <TextBlock Text="Провайдер:"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  Margin="0,0,0,5"
                                  ToolTip="Выберите AI провайдера"
                                  Height="34"/>
                        <TextBlock Text="Провайдер определяет источник AI моделей для генерации ответов"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Выбор модели -->
                    <StackPanel Margin="10">
                        <TextBlock Text="Модель:"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold" />
                        <controls:SearchableComboBox ItemsSource="{Binding ModelDisplayNames}"
                                                     SelectedItem="{Binding SelectedModelDisplayName}"
                                                     Placeholder="Поиск модели..."
                                                     Margin="0,0,0,5"
                                                     ToolTip="Выберите модель AI" />
                        <TextBlock Text="Модель определяет конкретную AI систему для генерации ответов"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Настройки для OpenRouter -->
                    <local:OpenRouterSettingsControl
                        Margin="10,0"
                        DataContext="{Binding}"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=OpenRouter}"/>

                    <!-- Настройки для Ollama -->
                    <local:OllamaSettingsControl
                        DataContext="{Binding}"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource ProviderTypeToVisibilityConverter}, ConverterParameter=Ollama}"/>

                    <!-- Настройки генерации -->
                    <StackPanel Margin="10">
                        <TextBlock Text="Temperature:"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Value="{Binding Temperature}"
                                    Minimum="0"
                                    Maximum="2"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Temperature, StringFormat='{}{0:F1}'}"
                                       Margin="10,0,0,0"
                                       MinWidth="30"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Max Tokens:"
                                   Margin="0,10,0,5"
                                   FontWeight="SemiBold" />
                        <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5" />
                        <TextBlock Text="Максимальное количество токенов в ответе (оставьте пустым для автоматического определения)"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Общие настройки -->
                    <StackPanel Margin="10">
                        <CheckBox Content="Автосохранение диалогов"
                                  IsChecked="{Binding AutoSaveConversations}"
                                  Margin="0,0,0,10" />
                        <CheckBox Content="Показывать статистику токенов"
                                  IsChecked="{Binding ShowTokenStats}"
                                  Margin="0,0,0,10" />
                        <CheckBox Content="Включить звуковые уведомления"
                                  IsChecked="{Binding EnableSoundNotifications}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки действий -->
            <Grid Grid.Row="2"
                  Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1"
                       Content="Сбросить"
                       Command="{Binding ResetSettingsCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="2"
                       Content="Применить"
                       Command="{Binding SaveSettingsCommand}"
                       Padding="15,8"
                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                       Background="#007ACC"
                       Foreground="White"
                       BorderThickness="0"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>