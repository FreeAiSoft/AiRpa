<UserControl x:Class="RPA.AiAgent.Control.McpAutoApproveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:converters="clr-namespace:RPA.AiAgent.Converters"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="450"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Converters -->
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        
        <!-- Стиль для ToggleButton инструмента -->
        <Style x:Key="McpToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#4A90E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок управления -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="6"
            MaxWidth="600"
            MaxHeight="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Auto-approve"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Run these actions without asking for permission. Only enable for actions you fully trust."
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding CloseMcpAutoApproveCommand}"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Закрыть">
                        <materialIcons:MaterialIcon Kind="Close"
                                                   Width="18"
                                                   Height="18"
                                                   Foreground="#666666"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Прокручиваемый список инструментов с индикатором загрузки -->
            <Grid Grid.Row="1">
                <!-- Индикатор загрузки -->
                <Grid x:Name="LoadingPanel"
                      Background="White"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock Text="⏳"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Foreground="#4A90E2"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Loading tools..."
                                  FontSize="14"
                                  Foreground="#666666"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                
                <!-- Список инструментов с виртуализацией -->
                <ScrollViewer x:Name="ToolsScrollViewer"
                             VerticalScrollBarVisibility="Auto"
                             Padding="16"
                             Visibility="Visible">
                    <ItemsControl ItemsSource="{Binding McpToolPermissions}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsApproved, Mode=TwoWay}"
                                            Style="{StaticResource McpToolToggleStyle}"
                                            Content="{Binding DisplayName}"
                                            ToolTip="{Binding Description}"
                                            Tag="{Binding Icon}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Панель управления -->
            <Border Grid.Row="2"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки выбора -->
                    <StackPanel Grid.Column="0"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">
                        <Button Command="{Binding SelectAllToolsCommand}"
                               Style="{StaticResource ControlButtonStyle}"
                               Tag="SelectAll"
                               Content="All"/>
                        <Button Command="{Binding SelectNoneToolsCommand}"
                               Style="{StaticResource ControlButtonStyle}"
                               Tag="SelectOff"
                               Content="None"/>
                    </StackPanel>

                    <!-- Индикатор состояния -->
                    <StackPanel Grid.Column="1"
                               Orientation="Horizontal"
                               VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding IsGlobalAutoApproveEnabled, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="6"
                                     Cursor="Hand"
                                     ToolTip="Включить/выключить автоодобрение">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                       Padding="{TemplateBinding Padding}"
                                                       CornerRadius="12"
                                                       Width="40"
                                                       Height="24">
                                                    <Ellipse x:Name="Switch"
                                                           Width="10"
                                                           Height="10"
                                                           Fill="White"
                                                           HorizontalAlignment="Left"
                                                           Margin="2,0,0,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Switch" Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter TargetName="Switch" Property="Margin" Value="0,0,2,0"/>
                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter Property="Background" Value="#666666"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <TextBlock Text="Enabled"
                                  FontSize="12"
                                  Foreground="{Binding IsGlobalAutoApproveEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#4CAF50|#666666}"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>