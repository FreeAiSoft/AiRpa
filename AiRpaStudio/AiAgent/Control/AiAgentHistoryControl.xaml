<UserControl x:Class="RPA.AiAgent.Control.AiAgentHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:converters="clr-namespace:RPA.AiAgent.Converters"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="600">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        
        <!-- Стиль для кнопок действий без эффекта наведения -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="История диалогов"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseHistoryCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Закрыть">
                    <materialIcons:MaterialIcon Kind="Close"
                                                Width="20"
                                                Height="20"/>
                </Button>
            </Grid>

            <!-- Список диалогов -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ConversationHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1"
                                    Padding="10"
                                    Margin="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Заголовок диалога -->
                                    <TextBlock Grid.Row="0" 
                                               Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,5"/>

                                    <!-- Дата и модель -->
                                    <TextBlock Grid.Row="1" 
                                               Grid.Column="0"
                                               FontSize="11"
                                               Foreground="Gray"
                                               Margin="0,0,0,5">
                                        <Run Text="{Binding UpdatedAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding ModelName}"/>
                                    </TextBlock>

                                    <!-- Количество сообщений -->
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               FontSize="10"
                                               Foreground="Gray">
                                        <Run Text="Сообщений: "/>
                                        <Run Text="{Binding Messages.Count, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Кнопка загрузки -->
                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Grid.RowSpan="3"
                                            Command="{Binding DataContext.LoadConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Margin="5,0"
                                            ToolTip="Загрузить диалог">
                                        <materialIcons:MaterialIcon Kind="FolderOpen"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="#007ACC"/>
                                    </Button>

                                    <!-- Кнопка удаления -->
                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.RowSpan="3"
                                            Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            ToolTip="Удалить диалог">
                                        <materialIcons:MaterialIcon Kind="DeleteOutline"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="#D32F2F"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Информация о пустой истории -->
            <TextBlock Grid.Row="1"
                       Text="История диалогов пуста"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasConversationHistory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

            <!-- Кнопка обновления -->
            <Button Grid.Row="2"
                    Content="Обновить"
                    Command="{Binding RefreshHistoryCommand}"
                    Padding="15,8"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MahApps.Styles.Button.Flat}"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"/>

        </Grid>
    </Border>
</UserControl>