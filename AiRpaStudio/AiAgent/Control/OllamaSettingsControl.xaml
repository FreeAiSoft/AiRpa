<UserControl x:Class="RPA.AiAgent.Control.OllamaSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RPA.AiAgent.Converters"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Информация о выбранной модели -->
        <Border BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Background="#F9F9F9"
                Margin="10,10,10,0"
                Visibility="{Binding SelectedModel, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedModel.DisplayName}"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,8" />

                <!-- Технические характеристики -->
                <StackPanel Margin="0,0,0,8">
                    <!-- Размер модели -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <TextBlock Text="Размер: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.SizeFormatted}"
                                   Foreground="#555555" />
                    </StackPanel>

                    <!-- Размер параметров -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4"
                                Visibility="{Binding SelectedModel.ParameterSize, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Параметры: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.ParameterSize}"
                                   Foreground="#555555" />
                    </StackPanel>

                    <!-- Семейство -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4"
                                Visibility="{Binding SelectedModel.Family, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Семейство: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.Family}"
                                   Foreground="#555555" />
                    </StackPanel>

                    <!-- Квантизация -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4"
                                Visibility="{Binding SelectedModel.QuantizationLevel, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Квантизация: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.QuantizationLevel}"
                                   Foreground="#555555" />
                    </StackPanel>

                    <!-- Формат -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding SelectedModel.Format, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Формат: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.Format}"
                                   Foreground="#555555" />
                    </StackPanel>
                </StackPanel>

                <TextBlock FontSize="10"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="Модель загружена локально через Ollama" />
            </StackPanel>
        </Border>

        <StackPanel Margin="10"
                    Grid.Row="1">
            <TextBlock Text="URL сервера:"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold" />
            <TextBox Text="{Binding OllamaUrl, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,5"
                     ToolTip="Введите URL сервера Ollama" />
            <TextBlock Text="По умолчанию: http://localhost:11434"
                       FontSize="10"
                       Foreground="Gray"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap" />

            <Button Content="Проверить подключение"
                    Command="{Binding TestOllamaConnectionCommand}"
                    Margin="0,5,0,0"
                    Padding="10,5"
                    Style="{StaticResource MahApps.Styles.Button.Flat}"
                    ToolTip="Проверить доступность сервера Ollama" />
        </StackPanel>
    </Grid>
    
</UserControl>