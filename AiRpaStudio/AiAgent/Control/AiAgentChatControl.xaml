<UserControl x:Class="RPA.AiAgent.Control.AiAgentChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RPA.AiAgent.Control"
             xmlns:controls="clr-namespace:RPA.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:converters="clr-namespace:RPA.AiAgent.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:MessageAlignmentConverter x:Key="MessageAlignmentConverter" />
            <converters:MessageBackgroundConverter x:Key="MessageBackgroundConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:MessageContentToPartsConverter x:Key="MessageContentToPartsConverter" />

            <!-- Custom Expander Style to override MahApps.Metro styles -->
            <Style x:Key="TransparentExpanderStyle" TargetType="Expander">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <DockPanel>
                                    <!-- Header -->
                                    <ContentPresenter DockPanel.Dock="Top"
                                                      ContentSource="Header"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      Margin="0"/>
                                    <!-- Content -->
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Visibility="Collapsed"
                                                      Margin="0"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom ToggleButton Style for Expander Header -->
            <Style x:Key="TransparentExpanderHeaderStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Expand/Collapse Arrow -->
                                    <Path x:Name="Arrow"
                                          Grid.Column="0"
                                          Data="M 0 0 L 4 4 L 0 8 Z"
                                          Fill="#666666"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <!-- Content -->
                                    <ContentPresenter Grid.Column="1"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Arrow"
                                                               Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                               To="90"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Arrow"
                                                               Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                               To="0"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Arrow" Property="Fill" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Template for plain text content parts -->
            <DataTemplate x:Key="TextPartTemplate">
                <TextBox Text="{Binding Content, Mode=OneWay}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Cursor="IBeam"
                         Margin="0,0,0,4" />
            </DataTemplate>

            <!-- Template for code block content parts with collapsible Expander -->
            <DataTemplate x:Key="CodeBlockPartTemplate">
                <Expander IsExpanded="False"
                          Margin="0,4,0,4">
                    <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource TransparentExpanderStyle}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Mode=TwoWay}"
                                                      Style="{StaticResource TransparentExpanderHeaderStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="JSON-RPC Command"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" (click to expand)"
                                                           FontSize="11"
                                                           Foreground="#666666"
                                                           FontStyle="Italic"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Expander.Style>
                    <Border Background="#E8E8E8"
                            BorderThickness="0"
                            Padding="8"
                            Margin="0,4,0,0">
                        <TextBox Text="{Binding Content, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 FontFamily="Consolas"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="300"
                                 Cursor="IBeam" />
                    </Border>
                </Expander>
            </DataTemplate>

            <!-- Content part template selector -->
            <converters:ContentPartTemplateSelector x:Key="ContentPartTemplateSelector"
                                                     TextTemplate="{StaticResource TextPartTemplate}"
                                                     CodeBlockTemplate="{StaticResource CodeBlockPartTemplate}" />

            <!-- Стиль для обычных сообщений -->
            <DataTemplate x:Key="MessageTemplate">
                <Grid HorizontalAlignment="{Binding Role, Converter={StaticResource MessageAlignmentConverter}}"
                      MaxWidth="600"
                      Margin="5,2">
                    <Border Background="{Binding Role, Converter={StaticResource MessageBackgroundConverter}}"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Role}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Opacity="0.7"
                                       Margin="0,0,0,4" />
                            <!-- Use ItemsControl to render parsed content parts -->
                            <ItemsControl ItemsSource="{Binding Content, Converter={StaticResource MessageContentToPartsConverter}}"
                                          ItemTemplateSelector="{StaticResource ContentPartTemplateSelector}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                           FontSize="10"
                                           Opacity="0.6" />
                                <TextBlock Text=" • Печатает..."
                                           FontSize="10"
                                           Opacity="0.6"
                                           Margin="4,0,0,0"
                                           Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Copy Button -->
                    <Button Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Width="24"
                            Height="24"
                            Margin="0,4,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Opacity="0.6"
                            Cursor="Hand"
                            ToolTip="Копировать содержимое">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialIcons:MaterialIcon Kind="ContentCopy"
                                                    Width="16"
                                                    Height="16" />
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- Стиль для системных сообщений -->
            <DataTemplate x:Key="SystemMessageTemplate">
                <Grid HorizontalAlignment="Center"
                      MaxWidth="650"
                      Margin="5,8">
                    <Border Background="#FFF3CD"
                            BorderBrush="#FFC107"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="🤖 Система"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="#856404"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding Content, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="#856404"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Cursor="IBeam" />
                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                       FontSize="10"
                                       Foreground="#856404"
                                       Opacity="0.7"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Copy Button -->
                    <Button Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Width="24"
                            Height="24"
                            Margin="0,4,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Opacity="0.6"
                            Cursor="Hand"
                            ToolTip="Копировать содержимое">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialIcons:MaterialIcon Kind="ContentCopy"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="#856404" />
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- Стиль для MCP команд -->
            <DataTemplate x:Key="McpCommandTemplate">
                <Grid HorizontalAlignment="Center"
                      MaxWidth="700"
                      Margin="5,10">
                    <Border Background="#E8F5E9"
                            BorderBrush="#4CAF50"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,6">
                                <TextBlock Text="MCP Команда"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="#2E7D32"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            
                            <Border Background="#F1F8E9"
                                    BorderBrush="#C5E1A5"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <TextBox Text="{Binding Content, Mode=OneWay}"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         FontFamily="Consolas"
                                         Foreground="#1B5E20"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Cursor="IBeam" />
                            </Border>
                            
                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                       FontSize="10"
                                       Foreground="#2E7D32"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                    <!-- Copy Button -->
                    <Button Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Width="24"
                            Height="24"
                            Margin="0,4,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Opacity="0.6"
                            Cursor="Hand"
                            ToolTip="Копировать содержимое">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialIcons:MaterialIcon Kind="ContentCopy"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="#2E7D32" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">

        <!-- Основной контент чата -->
        <Grid Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Панель управления -->
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ShowAvailableActivitiesCommand}"
                                Style="{StaticResource SquareButtonStyle}"
                                ToolTip="Показать список доступных активностей">
                            <materialIcons:MaterialIcon Kind="LocalActivity"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Command="{Binding LoadModelsCommand}"
                                Style="{StaticResource SquareButtonStyle}"
                                ToolTip="Обновить">
                            <materialIcons:MaterialIcon Kind="Refresh"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Command="{Binding ClearChatCommand}"
                                Style="{StaticResource SquareButtonStyle}"
                                ToolTip="Очистить">
                            <materialIcons:MaterialIcon Kind="ChatDeleteOutline"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Command="{Binding SaveConversationCommand}"
                                Style="{StaticResource SquareButtonStyle}"
                                ToolTip="Копировать чат в буфер обмена">
                            <materialIcons:MaterialIcon Kind="ContentCopy"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Command="{Binding HistoryCommand}"
                                Style="{StaticResource SquareButtonStyle}"
                                ToolTip="История чатов">
                            <materialIcons:MaterialIcon Kind="History"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Command="{Binding SettingsCommand}"
                                Style="{StaticResource SquareButtonLastStyle}"
                                ToolTip="Настройки">
                            <materialIcons:MaterialIcon Kind="SettingsOutline"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Command="{Binding CancelGenerationCommand}"
                                Style="{StaticResource SquareButtonWithoutLeftBorder}"
                                ToolTip="Остановить"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}">
                            <materialIcons:MaterialIcon Kind="Stop"
                                                        Width="16"
                                                        Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Панель статистики -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <!-- Контекст -->
                        <TextBlock Text="{Binding SessionContextInfo}"
                                   Foreground="#444444"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   ToolTip="Использованный контекст / Максимальный контекст модели" />

                        <!-- Стоимость -->
                        <TextBlock Text="{Binding SessionCostFormatted}"
                                   Foreground="#444444"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   ToolTip="Стоимость за текущий сеанс" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Область сообщений -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  VirtualizingPanel.IsVirtualizing="True">
                        <ItemsControl.ItemTemplateSelector>
                            <converters:MessageTemplateSelector MessageTemplate="{StaticResource MessageTemplate}"
                                                                SystemMessageTemplate="{StaticResource SystemMessageTemplate}"
                                                                McpCommandTemplate="{StaticResource McpCommandTemplate}" />
                        </ItemsControl.ItemTemplateSelector>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Строка статуса -->
            <Border Grid.Row="2"
                    Background="#F9F9F9"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Padding="10,5"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="#666666" />
            </Border>

            <!-- Поле ввода -->
            <Border Grid.Row="3"
                    Background="White"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Background="White"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Padding="2">
                        <TextBox x:Name="InputTextBox"
                                 Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="100"
                                 BorderThickness="0"
                                 Padding="8"
                                 FontSize="13"
                                 PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                 IsEnabled="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        </TextBox>
                    </Border>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Command="{Binding SendMessageCommand}"
                            Width="40"
                            Height="40"
                            Margin="8,0,0,0"
                            Background="Transparent"
                            Foreground="Gray"
                            BorderThickness="0"
                            VerticalAlignment="Bottom">
                        <materialIcons:MaterialIcon Kind="Send"
                                                    Width="28"
                                                    Height="28" />
                    </Button>

                    <!-- MCP Auto-Approve Button -->
                    <Button Command="{Binding ToggleMcpAutoApproveCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Grid.Row="1"
                            Margin="5"
                            HorizontalAlignment="Left"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            ToolTip="MCP инструменты - настройки автоодобрения">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ApprovedToolsCount}" />
                            <TextBlock Text=" auto-approved" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Панель настроек (заполняет весь Grid) -->
        <Grid d:Visibility="Hidden"
              Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:AiAgentSettingsControl DataContext="{Binding}" />
        </Grid>

        <!-- Панель истории (заполняет весь Grid) -->
        <Grid d:Visibility="Hidden"
              Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:AiAgentHistoryControl DataContext="{Binding}" />
        </Grid>

        <!-- Панель MCP Auto-Approve (заполняет весь Grid с затемнением) -->
        <Grid d:Visibility="Hidden"
              Visibility="{Binding IsMcpAutoApproveVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Затемняющий фон -->
            <Rectangle Fill="Black"
                      Opacity="0.5"
                      MouseDown="PopupBackground_MouseDown"/>
            
            <!-- Центрированный контрол -->
            <local:McpAutoApproveControl DataContext="{Binding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="20,20,20,70" />
        </Grid>

    </Grid>
</UserControl>
