<UserControl x:Class="RPA.AiAgent.Control.OpenRouterSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RPA.AiAgent.Converters"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="500">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="API Ключ:"
                   Margin="0,0,0,5"
                   FontWeight="SemiBold" />
        <PasswordBox x:Name="OpenRouterApiKeyBox"
                     Margin="0,0,0,10"
                     PasswordChanged="OpenRouterApiKeyBox_PasswordChanged"
                     ToolTip="Введите ваш API ключ OpenRouter" />
        <TextBlock Text="Сохраняется локально в настройках приложения"
                   FontSize="10"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15" />

        <!-- Информация о выбранной модели -->
        <Border BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Background="#F9F9F9"
                Visibility="{Binding SelectedModel, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedModel.DisplayName}"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,8" />
                
                <TextBlock Text="{Binding SelectedModel.Description}"
                           TextWrapping="Wrap"
                           Foreground="#333333"
                           Margin="0,0,0,12"
                           LineHeight="18" />

                <!-- Технические характеристики -->
                <StackPanel Margin="0,0,0,8">
                    <!-- Context Window -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Context Window: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Foreground="#555555">
                            <Run Text="{Binding SelectedModel.ContextLength, StringFormat='{}{0:N0}', Mode=OneWay}" />
                            <Run Text=" tokens" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Pricing -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Input price: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.PromptPrice, StringFormat='${0:F2} / 1M tokens', Mode=OneWay}"
                                   Foreground="#555555" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Output price: "
                                   FontWeight="SemiBold"
                                   Foreground="#555555" />
                        <TextBlock Text="{Binding SelectedModel.CompletionPrice, StringFormat='${0:F2} / 1M tokens', Mode=OneWay}"
                                   Foreground="#555555" />
                    </StackPanel>
                </StackPanel>

                <TextBlock FontSize="10"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0">
                    <Run Text="Подробнее о модели:" />
                    <Hyperlink NavigateUri="https://openrouter.ai/models"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="openrouter.ai/models" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>