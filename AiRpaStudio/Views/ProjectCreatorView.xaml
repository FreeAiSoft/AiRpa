<Window x:Class="RPA.Views.ProjectCreatorView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:RPA.Views"
                 mc:Ignorable="d"
                 Height="290"
                 Width="450"
                 Title="Create project"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Normal"
                 ResizeMode="NoResize"
                 Background="{DynamicResource Studio.Surface}"
                 Foreground="{DynamicResource Studio.Foreground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition />
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="NoWrap"
                 Margin="0,0,0,8"
                 VerticalContentAlignment="Center"
                 ToolTip="project name"/>
        <Grid Grid.Row="1"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SelectedPath}"
                     ToolTip="root path"
                     VerticalContentAlignment="Center" />
            <Button Content="..."
                    Command="{Binding Cmd}"
                    CommandParameter="SetFolder"
                    Margin="8,0,0,0"
                    Width="28"
                    Grid.Column="1"/>
        </Grid>
        <TextBox Text="{Binding Project.Description, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="2"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 ToolTip="project description"/>
        <Button Content="Create"
                Command="{Binding Cmd}"
                CommandParameter="CreateProject"
                Grid.Row="3"
                Height="32"/>
    </Grid>
</Window>
