<UserControl x:Class="RPA.Views.DesignerErrorBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BannerIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Studio.Surface}"
            BorderBrush="{DynamicResource Studio.Semantic.Stop}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Rectangle x:Name="ErrorIcon"
                       Grid.Column="0"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Margin="10,0,8,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Studio.Foreground}" />

            <Button Grid.Column="2"
                    Style="{StaticResource BannerIconButton}"
                    Width="24"
                    Height="24"
                    ToolTip="Копировать"
                    Click="OnCopyClick">
                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                      Fill="{DynamicResource Studio.ForegroundMuted}"
                      Stretch="Uniform"
                      Width="14"
                      Height="14" />
            </Button>

            <Button Grid.Column="3"
                    Style="{StaticResource BannerIconButton}"
                    Width="24"
                    Height="24"
                    ToolTip="Отправить в чат"
                    Click="OnSendClick">
                <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                      Fill="{DynamicResource Studio.ForegroundMuted}"
                      Stretch="Uniform"
                      Width="14"
                      Height="14" />
            </Button>

            <Button Grid.Column="4"
                    Style="{StaticResource BannerIconButton}"
                    Width="24"
                    Height="24"
                    ToolTip="Закрыть"
                    Click="OnCloseClick">
                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource Studio.ForegroundMuted}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
