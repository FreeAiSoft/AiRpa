<Window x:Class="RPA.Views.MainView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:RPA.Views"
                 xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
                 xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
                 xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Metro"
                 xmlns:logControl="clr-namespace:LogControlLibrary.Controls;assembly=LogControlLibrary"
                 xmlns:mw="clr-namespace:RPA.Helpers"
                 xmlns:controls="clr-namespace:RPA.Controls"
                 xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                 xmlns:converters="clr-namespace:RPA.Converters"
                 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 mc:Ignorable="d"
                 Title="RPA"
                 Background="{DynamicResource Studio.Surface}"
                 Height="650"
                 Width="1100"
                 WindowState="Maximized"
                 Loaded="MainView_Loaded"
                 StateChanged="MainView_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Converters -->
        <converters:IsStoppedConverter x:Key="IsStoppedConverter"/>
        <converters:CanRunConverter x:Key="CanRunConverter"/>
        <converters:CanPauseConverter x:Key="CanPauseConverter"/>
        <converters:CanStopConverter x:Key="CanStopConverter"/>
        <Style x:Key="codeIconsStyle"
               TargetType="materialIcons:MaterialIcon">
            <Setter Property="Width"
                    Value="20" />
            <Setter Property="Height"
                    Value="20" />
        </Style>
        <Style x:Key="iconMicronsStyle"
               TargetType="materialIcons:MaterialIcon">
            <Setter Property="Width"
                    Value="20" />
            <Setter Property="Height"
                    Value="20" />
        </Style>
        <!-- Стиль для обычных кнопок в стиле toggle -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="BorderThickness"
                    Value="1,1,0,1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.ToolbarBorder}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.4" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarPressedBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для последней обычной кнопки -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonLastStyle"
               BasedOn="{StaticResource LogLevelButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1,1,1,1" />
        </Style>

        <!-- Стиль для переключателя темы (кнопка справа от тулбара) -->
        <Style TargetType="ToggleButton"
               x:Key="ThemeToggleButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.ToolbarBorder}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.4" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsChecked"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarCheckedBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопки заголовка окна -->
        <Style TargetType="Button"
               x:Key="TitleBarButtonStyle">
            <Setter Property="Width"
                    Value="46" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Studio.TitleBarForeground}" />
            <Setter Property="TextElement.Foreground"
                    Value="{DynamicResource Studio.TitleBarForeground}" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.TitleBarButtonHoverBackground}" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button"
               x:Key="TitleBarCloseButtonStyle"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.TitleBarButtonCloseHoverBackground}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Studio.TitleBarButtonCloseForeground}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{DynamicResource Studio.TitleBarButtonCloseForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Тёмная/светлая подложка тулбара -->
        <Style TargetType="ToolBar">
            <Setter Property="Background"
                    Value="{DynamicResource Studio.ToolbarBackground}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <Border Background="{TemplateBinding Background}">
                            <ToolBarPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolBarTray">
            <Setter Property="Background"
                    Value="{DynamicResource Studio.ToolbarBackground}" />
        </Style>

        <!-- ==================== MenuItem: собственные шаблоны ====================
             Стандартные шаблоны WPF используют жёстко зашитые цвета (#FFF0F0F0 для
             выпадающего подменю, #3D26A0DA для подсветки), поэтому переопределяем
             их целиком и привязываем к теме. -->

        <!-- Верхний пункт меню с выпадающим подменю -->
        <ControlTemplate x:Key="MenuItemTopLevelHeaderTemplate"
                         TargetType="MenuItem">
            <Border x:Name="Border"
                    Background="Transparent"
                    SnapsToDevicePixels="True">
                <DockPanel>
                    <ContentPresenter x:Name="HeaderHost"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="8,0,8,0" />
                    <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource Studio.MenuBackground}"
                                BorderBrush="{DynamicResource Studio.ToolbarBorder}"
                                BorderThickness="1"
                                Padding="2">
                            <ScrollViewer CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                Margin="2"
                                                SnapsToDevicePixels="True" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter TargetName="Border"
                            Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger SourceName="PART_Popup"
                         Property="IsOpen"
                         Value="True">
                    <Setter TargetName="Border"
                            Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Верхний пункт меню без подменю -->
        <ControlTemplate x:Key="MenuItemTopLevelItemTemplate"
                         TargetType="MenuItem">
            <Border x:Name="Border"
                    Background="Transparent"
                    SnapsToDevicePixels="True">
                <DockPanel>
                    <ContentPresenter x:Name="HeaderHost"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="8,0,8,0" />
                </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter TargetName="Border"
                            Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Пункт выпадающего меню с вложенным подменю -->
        <ControlTemplate x:Key="MenuItemSubmenuHeaderTemplate"
                         TargetType="MenuItem">
            <Border x:Name="Border"
                    Background="Transparent"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="HeaderHost"
                                      Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="8,2,8,2" />
                    <Path x:Name="Arrow"
                          Grid.Column="2"
                          Data="M 0 0 L 4 3.5 L 0 7 Z"
                          Fill="{TemplateBinding Foreground}"
                          Margin="4,0,8,0"
                          VerticalAlignment="Center" />
                    <Popup x:Name="PART_Popup"
                           Placement="Right"
                           HorizontalOffset="-1"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource Studio.MenuBackground}"
                                BorderBrush="{DynamicResource Studio.ToolbarBorder}"
                                BorderThickness="1"
                                Padding="2">
                            <ScrollViewer CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                Margin="2"
                                                SnapsToDevicePixels="True" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter TargetName="Border"
                            Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger SourceName="PART_Popup"
                         Property="IsOpen"
                         Value="True">
                    <Setter TargetName="Border"
                            Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Обычный пункт выпадающего меню -->
        <ControlTemplate x:Key="MenuItemSubmenuItemTemplate"
                         TargetType="MenuItem">
            <Border x:Name="Border"
                    Background="Transparent"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="HeaderHost"
                                      Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="8,2,8,2" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted"
                         Value="True">
                    <Setter TargetName="Border"
                            Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Стиль MenuItem: тематический текст + выбор шаблона по роли -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource Studio.MenuForeground}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
            <Setter Property="Template"
                    Value="{StaticResource MenuItemSubmenuItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="Role"
                         Value="TopLevelHeader">
                    <Setter Property="Template"
                            Value="{StaticResource MenuItemTopLevelHeaderTemplate}" />
                </Trigger>
                <Trigger Property="Role"
                         Value="TopLevelItem">
                    <Setter Property="Template"
                            Value="{StaticResource MenuItemTopLevelItemTemplate}" />
                </Trigger>
                <Trigger Property="Role"
                         Value="SubmenuHeader">
                    <Setter Property="Template"
                            Value="{StaticResource MenuItemSubmenuHeaderTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Меню: стандартный шаблон WPF использует жёстко зашитый светлый фон (#FFF0F0F0),
             поэтому задаём собственный шаблон с привязкой к теме -->
        <Style TargetType="Menu">
            <Setter Property="Background"
                    Value="{DynamicResource Studio.MenuBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Studio.MenuForeground}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="{DynamicResource Studio.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region TitleBar-->
        <Grid Grid.Row="0"
              Background="{DynamicResource Studio.TitleBarBackground}"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="RPA"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Studio.TitleBarForeground}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,0,5,0">
                <Button ToolTip="Minimize"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="TitleBarMinimize_Click">
                    <materialIcons:MaterialIcon Kind="WindowMinimize"
                                                Width="16"
                                                Height="16" />
                </Button>
                <Button x:Name="MaximizeButton"
                        ToolTip="Maximize"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="TitleBarMaximize_Click">
                    <materialIcons:MaterialIcon x:Name="MaximizeIcon"
                                                Kind="WindowMaximize"
                                                Width="16"
                                                Height="16" />
                </Button>
                <Button ToolTip="Close"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="TitleBarClose_Click">
                    <materialIcons:MaterialIcon Kind="WindowClose"
                                                Width="16"
                                                Height="16" />
                </Button>
            </StackPanel>
        </Grid>
        <!--#endregion TitleBar-->

        <!--#region Top-->

        <Menu Grid.Row="1"
              Margin="5,0,0,0"
              FontFamily="Consolas"
              Background="{DynamicResource Studio.MenuBackground}">
            <MenuItem Header="{DynamicResource lang_main_file}"
                      Foreground="{DynamicResource Studio.MenuForeground}">
                <MenuItem Header="New process"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowNewProcess" />
                <MenuItem Header="{DynamicResource lang_main_new_vs_template}"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdVsNewProjectFromTemplate" />
                <MenuItem Header="{DynamicResource lang_main_open_vs_project}"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdVsOpenProject" />
                <MenuItem Header="Load project"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdTryLoadProject" />
                <MenuItem Header="Add new activity to project"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdAddNewActivityToProject" />
                <Separator />
                <MenuItem Header="Open"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowOpen" />
                <MenuItem Header="Save"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowSave" />
                <MenuItem Header="Save As..."
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowSaveAs" />
                <Separator />
                <MenuItem Header="Close"
                          Command="{Binding ActiveDocument.CloseCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource lang_main_settings}"
                      Foreground="{DynamicResource Studio.MenuForeground}">
                <MenuItem SnapsToDevicePixels="True"
                          ToolTip="Save Workspace Layout"
                          Header="Save Layout"
                          Click="SaveWorkspaceLayoutToStringCommand_Click"/>
                <MenuItem SnapsToDevicePixels="True"
                          ToolTip="Reset Workspace Layout"
                          Header="Reset Layout"
                          Click="RestWorkspaceLayout_Click"/>
                <MenuItem Command="{Binding ADLayout.LoadWorkspaceLayoutFromStringCommand}"
                          SnapsToDevicePixels="True"
                          ToolTip="Load Workspace Layout"
                          Header="Load Layout" />
            </MenuItem>
            <MenuItem Header="Tools"
                      Foreground="{DynamicResource Studio.MenuForeground}">
                <MenuItem Header="NuGet Package Manager"
                          Click="NuGetPanelMenuItem_Click" />
            </MenuItem>
           
        </Menu>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--#region Верхние кнопки-->
            <ToolBarTray Grid.Column="0"
                         SnapsToDevicePixels="True">
                <ToolBar  VerticalAlignment="Stretch"
                          ToolBarTray.IsLocked="True"
                          Margin="5 0 0 0">
                    <ToolBar.Resources>
                        <Style TargetType="materialIcons:MaterialIcon">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Studio.ToolbarForeground}" />
                        </Style>
                    </ToolBar.Resources>

                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdAddNewActivityToProject"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource IsStoppedConverter}}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="FileDocumentPlusOutline"
                                                    Width="20"
                                                    Height="20" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            Foreground="{DynamicResource Studio.ToolbarForeground}"
                            CommandParameter="CmdWorkflowSave"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline"
                                                    Width="20"
                                                    Height="20" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            Foreground="{DynamicResource Studio.ToolbarForeground}"
                            CommandParameter="CmdWorkflowSaveAll"
                            IsEnabled="{Binding CanSaveAll}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="ContentSaveAllOutline"
                                                    Width="20"
                                                    Height="20" />
                    </Button>

                    <Separator Margin="5"
                               Width="1"
                               Height="28"
                               Foreground="{DynamicResource Studio.ToolbarBorder}"/>
                    
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdWorkflowRun"
                            Foreground="{DynamicResource Studio.Semantic.Run}"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource CanRunConverter}}"
                            Style="{StaticResource LogLevelButtonStyle}">
                        <materialIcons:MaterialIcon Kind="Play"
                                                    Width="24"
                                                    Height="24" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdWorkflowPause"
                            Foreground="{DynamicResource Studio.Semantic.Pause}"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource CanPauseConverter}}"
                            Style="{StaticResource LogLevelButtonStyle}">
                        <materialIcons:MaterialIcon Kind="Pause"
                                                    Width="24"
                                                    Height="24" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdWorkflowStop"
                            Foreground="{DynamicResource Studio.Semantic.Stop}"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource CanStopConverter}}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="Stop"
                                                    Width="24"
                                                    Height="24" />
                    </Button>

                    <Separator Margin="5"
                               Width="1"
                               Height="28"
                               Foreground="{DynamicResource Studio.ToolbarBorder}"/>
                    
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdUndo"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource IsStoppedConverter}}"
                            Style="{StaticResource LogLevelButtonStyle}">
                        <materialIcons:MaterialIcon Kind="ArrowULeftTop"
                                                    Width="20"
                                                    Height="20" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdRedo"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource IsStoppedConverter}}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="ArrowURightTop"
                                                    Width="20"
                                                    Height="20" />
                    </Button>

                    <Separator Margin="5"
                               Width="1"
                               Height="28"
                               Foreground="{DynamicResource Studio.ToolbarBorder}" />
                    <ComboBox ItemsSource="{Binding Langs}"
                              Margin="3"
                              SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Grid.Column="1"
                                  Style="{StaticResource ThemeToggleButtonStyle}"
                                  ToolTip="Toggle dark / light theme"
                                  VerticalAlignment="Center"
                                  Margin="5,0,5,0">
                        <materialIcons:MaterialIcon Kind="ThemeLightDark"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="{DynamicResource Studio.ToolbarForeground}" />
                    </ToggleButton>

                </ToolBar>
            </ToolBarTray>
            <!--#endregion Верхние кнопки-->

            
        </Grid>

        <!--#endregion Top-->

        <avalonDock:DockingManager x:Name="dockManager"
                                   x:FieldModifier="private"
                                   SnapsToDevicePixels="True"
