<Window x:Class="RPA.Views.MainView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:RPA.Views"
                 xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
                 xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
                 xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Metro"
                 xmlns:logControl="clr-namespace:LogControlLibrary.Controls;assembly=LogControlLibrary"
                 xmlns:mw="clr-namespace:RPA.Helpers"
                 xmlns:controls="clr-namespace:RPA.Controls"
                 xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                 xmlns:converters="clr-namespace:RPA.Converters"
                 mc:Ignorable="d"
                 Title="RPA"
                 Height="650"
                 Width="1100"
                 WindowState="Maximized"
                 Loaded="MainView_Loaded">
    <Window.Resources>
        <!-- Converters -->
        <converters:IsStoppedConverter x:Key="IsStoppedConverter"/>
        <converters:CanRunConverter x:Key="CanRunConverter"/>
        <converters:CanPauseConverter x:Key="CanPauseConverter"/>
        <converters:CanStopConverter x:Key="CanStopConverter"/>
        <Style x:Key="codeIconsStyle"
               TargetType="materialIcons:MaterialIcon">
            <Setter Property="Width"
                    Value="20" />
            <Setter Property="Height"
                    Value="20" />
        </Style>
        <Style x:Key="iconMicronsStyle"
               TargetType="materialIcons:MaterialIcon">
            <Setter Property="Width"
                    Value="20" />
            <Setter Property="Height"
                    Value="20" />
        </Style>
        <!-- Стиль для обычных кнопок в стиле toggle -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="BorderThickness"
                    Value="1,1,0,1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.ToolbarBorder}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.4" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarPressedBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для последней обычной кнопки -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonLastStyle"
               BasedOn="{StaticResource LogLevelButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1,1,1,1" />
        </Style>

        <!-- Стиль для переключателя темы (кнопка справа от тулбара) -->
        <Style TargetType="ToggleButton"
               x:Key="ThemeToggleButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.ToolbarBorder}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.4" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarHoverBackground}" />
                </Trigger>
                <Trigger Property="IsChecked"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.ToolbarCheckedBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Тёмная/светлая подложка тулбара -->
        <Style TargetType="ToolBar">
            <Setter Property="Background"
                    Value="{DynamicResource Studio.ToolbarBackground}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <Border Background="{TemplateBinding Background}">
                            <ToolBarPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolBarTray">
            <Setter Property="Background"
                    Value="{DynamicResource Studio.ToolbarBackground}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Studio.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--#region Top-->

        <Menu Grid.Row="0"
              FontFamily="Consolas"
              Background="{DynamicResource Studio.MenuBackground}">
            <MenuItem Header="{DynamicResource lang_main_file}"
                      Foreground="{DynamicResource Studio.MenuForeground}">
                <MenuItem Header="New process"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowNewProcess" />
                <MenuItem Header="{DynamicResource lang_main_new_vs_template}"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdVsNewProjectFromTemplate" />
                <MenuItem Header="{DynamicResource lang_main_open_vs_project}"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdVsOpenProject" />
                <MenuItem Header="Load project"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdTryLoadProject" />
                <MenuItem Header="Add new activity to project"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdAddNewActivityToProject" />
                <Separator />
                <MenuItem Header="Open"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowOpen" />
                <MenuItem Header="Save"
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowSave" />
                <MenuItem Header="Save As..."
                          Command="{Binding Cmd}"
                          CommandParameter="CmdWorkflowSaveAs" />
                <Separator />
                <MenuItem Header="Close"
                          Command="{Binding ActiveDocument.CloseCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource lang_main_settings}"
                      Foreground="{DynamicResource Studio.MenuForeground}">
                <MenuItem SnapsToDevicePixels="True"
                          ToolTip="Save Workspace Layout"
                          Header="Save Layout"
                          Click="SaveWorkspaceLayoutToStringCommand_Click"/>
                <MenuItem SnapsToDevicePixels="True"
                          ToolTip="Reset Workspace Layout"
                          Header="Reset Layout"
                          Click="RestWorkspaceLayout_Click"/>
                <MenuItem Command="{Binding ADLayout.LoadWorkspaceLayoutFromStringCommand}"
                          SnapsToDevicePixels="True"
                          ToolTip="Load Workspace Layout"
                          Header="Load Layout" />
            </MenuItem>
            <MenuItem Header="Tools"
                      Foreground="{DynamicResource Studio.MenuForeground}">
                <MenuItem Header="NuGet Package Manager"
                          Click="NuGetPanelMenuItem_Click" />
            </MenuItem>
           
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--#region Верхние кнопки-->
            <ToolBarTray Grid.Column="0"
                         SnapsToDevicePixels="True">
                <ToolBar  VerticalAlignment="Stretch"
                          ToolBarTray.IsLocked="True"
                          Margin="5 0 0 0">
                    <ToolBar.Resources>
                        <Style TargetType="materialIcons:MaterialIcon">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Studio.ToolbarForeground}" />
                        </Style>
                    </ToolBar.Resources>

                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdAddNewActivityToProject"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource IsStoppedConverter}}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="FileDocumentPlusOutline"
                                                    Width="20"
                                                    Height="20" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            Foreground="#4169E1"
                            CommandParameter="CmdWorkflowSave"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline"
                                                    Width="20"
                                                    Height="20" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            Foreground="#4169E1"
                            CommandParameter="CmdWorkflowSaveAll"
                            IsEnabled="{Binding CanSaveAll}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="ContentSaveAllOutline"
                                                    Width="20"
                                                    Height="20" />
                    </Button>

                    <Separator Margin="5"
                               Width="1"
                               Height="28"
                               Foreground="{DynamicResource Studio.ToolbarBorder}"/>
                    
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdWorkflowRun"
                            Foreground="#228B22"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource CanRunConverter}}"
                            Style="{StaticResource LogLevelButtonStyle}">
                        <materialIcons:MaterialIcon Kind="Play"
                                                    Width="24"
                                                    Height="24" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdWorkflowPause"
                            Foreground="Orange"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource CanPauseConverter}}"
                            Style="{StaticResource LogLevelButtonStyle}">
                        <materialIcons:MaterialIcon Kind="Pause"
                                                    Width="24"
                                                    Height="24" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdWorkflowStop"
                            Foreground="#DC143C"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource CanStopConverter}}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="Stop"
                                                    Width="24"
                                                    Height="24" />
                    </Button>

                    <Separator Margin="5"
                               Width="1"
                               Height="28"
                               Foreground="{DynamicResource Studio.ToolbarBorder}"/>
                    
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdUndo"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource IsStoppedConverter}}"
                            Style="{StaticResource LogLevelButtonStyle}">
                        <materialIcons:MaterialIcon Kind="ArrowULeftTop"
                                                    Width="20"
                                                    Height="20" />
                    </Button>
                    <Button ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"
                            Command="{Binding Cmd}"
                            CommandParameter="CmdRedo"
                            IsEnabled="{Binding CustomWfDesignerState, Converter={StaticResource IsStoppedConverter}}"
                            Style="{StaticResource LogLevelButtonLastStyle}">
                        <materialIcons:MaterialIcon Kind="ArrowURightTop"
                                                    Width="20"
                                                    Height="20" />
                    </Button>

                    <Separator Margin="5"
                               Width="1"
                               Height="28"
                               Foreground="{DynamicResource Studio.ToolbarBorder}" />
                    <ComboBox ItemsSource="{Binding Langs}"
                              Margin="3"
                              SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Grid.Column="1"
                                  Style="{StaticResource ThemeToggleButtonStyle}"
                                  ToolTip="Toggle dark / light theme"
                                  VerticalAlignment="Center"
                                  Margin="5,0,5,0">
                        <materialIcons:MaterialIcon Kind="ThemeLightDark"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="{DynamicResource Studio.ToolbarForeground}" />
                    </ToggleButton>

                </ToolBar>
            </ToolBarTray>
            <!--#endregion Верхние кнопки-->

            
        </Grid>

        <!--#endregion Top-->

        <avalonDock:DockingManager x:Name="dockManager"
                                   x:FieldModifier="private"
                                   SnapsToDevicePixels="True"
                                   Grid.Row="2">

            <avalonDock:DockingManager.Theme>
                <themes:MetroTheme />
            </avalonDock:DockingManager.Theme>

            
        </avalonDock:DockingManager>

    </Grid>
</Window>
