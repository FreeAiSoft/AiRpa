<Window x:Class="RPA.Views.ActivityCreatorView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:RPA.Views"
                 mc:Ignorable="d"
                 Height="165"
                 Width="450"
                 Title="Create activity"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Normal"
                 ResizeMode="NoResize">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <TextBox Text="{Binding ActivityName, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="NoWrap"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 ToolTip="activity name" />
        <TextBlock Text="{Binding SelectedPath}"
                 ToolTip="location"
                 Grid.Row="1"
                 Margin="10"/>
        <Button Content="Create"
                Command="{Binding Cmd}"
                CommandParameter="CreateActivity"
                Grid.Row="3"
                Margin="5" />
    </Grid>
</Window>
