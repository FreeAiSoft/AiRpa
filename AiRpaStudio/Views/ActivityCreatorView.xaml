<mah:MetroWindow x:Class="RPA.Views.ActivityCreatorView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:RPA.Views"
                 mc:Ignorable="d"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Height="165"
                 Width="450"
                 Title="Create activity"
                 WindowTransitionsEnabled="True"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Normal"
                 ResizeMode="NoResize"
                 GlowBrush="Gray"
                 NonActiveGlowBrush="Gray">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <TextBox Text="{Binding ActivityName, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="NoWrap"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 mah:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"
                 ToolTip="activity name"
                 mah:TextBoxHelper.ClearTextButton="True" />
        <TextBlock Text="{Binding SelectedPath}"
                 ToolTip="location"
                 Grid.Row="1"
                 Margin="10"
                 mah:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Button Content="Create"
                Command="{Binding Cmd}"
                CommandParameter="CreateActivity"
                Grid.Row="3"
                Style="{StaticResource MahApps.Styles.Button.Flat}"
                Margin="5" />
    </Grid>
</mah:MetroWindow>
