<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info">

  <targets>
    <!-- Лог производительности редактора выражений -->
    <target xsi:type="File" 
            name="performanceLog" 
            fileName="${basedir}/log.txt"
            layout="${longdate} | ${level:uppercase=true} | ${message}"
            encoding="utf-8"
            archiveFileName="${basedir}/log_archive_{#}.txt"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />
  </targets>

  <rules>
    <logger name="RoslynExpressionEditor.Performance" minlevel="Trace" writeTo="performanceLog" />
  </rules>
</nlog>
