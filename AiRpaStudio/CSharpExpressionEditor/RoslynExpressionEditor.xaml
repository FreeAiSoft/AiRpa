<sape:TextualExpressionEditor x:Class="RPA.CSharpExpressionEditor.RoslynExpressionEditor"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation"
                              xmlns:sape="clr-namespace:System.Activities.Presentation.Expressions;assembly=System.Activities.Presentation"
                              xmlns:local="clr-namespace:RPA.CSharpExpressionEditor"
                              xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                              xmlns:editor="clr-namespace:RoslynPad.Editor;assembly=RoslynPad.Editor.Windows"
                              mc:Ignorable="d"
                              d:DesignHeight="300"
                              d:DesignWidth="300"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
    <sape:TextualExpressionEditor.Resources>
        <sapc:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
        <local:LineToHeightConverter x:Uid="res:LineToHeightConverter_1"
                                     x:Key="lineToHeightConverter" />

        <Style TargetType="{x:Type TextBlock}"
               x:Key="textBlockStyle">
            <Setter x:Uid="Setter_3"
                    Property="Text"
                    Value="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}" />
            <Setter x:Uid="Setter_1"
                    Property="MinHeight">
                <Setter.Value>
                    <MultiBinding x:Uid="MultiBinding_1"
                                  Converter="{StaticResource lineToHeightConverter}"
                                  ConverterParameter="MinHeight">
                        <Binding x:Uid="Binding_1"
                                 Path="MinHeight"
                                 RelativeSource="{RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}" />
                        <Binding x:Uid="Binding_2"
                                 Path="FontFamily"
                                 RelativeSource="{RelativeSource Self}" />
                        <Binding x:Uid="Binding_3"
                                 Path="FontSize"
                                 RelativeSource="{RelativeSource Self}" />
                        <Binding x:Uid="Binding_4"
                                 Path="MinLines"
                                 RelativeSource="{RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter x:Uid="Setter_2"
                    Property="MaxHeight">
                <Setter.Value>
                    <MultiBinding x:Uid="MultiBinding_2"
                                  Converter="{StaticResource lineToHeightConverter}"
                                  ConverterParameter="MaxHeight">
                        <Binding x:Uid="Binding_5"
                                 Path="MaxHeight"
                                 RelativeSource="{RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}" />
                        <Binding x:Uid="Binding_6"
                                 Path="FontFamily"
                                 RelativeSource="{RelativeSource Self}" />
                        <Binding x:Uid="Binding_7"
                                 Path="FontSize"
                                 RelativeSource="{RelativeSource Self}" />
                        <Binding x:Uid="Binding_8"
                                 Path="MaxLines"
                                 RelativeSource="{RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger  x:Uid="DataTrigger_10"
                              Binding="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}"
                              Value="{x:Null}">
                    <Setter x:Uid="Setter_79"
                            Property="FontStyle"
                            Value="Italic" />
                    <Setter x:Uid="Setter_80"
                            Property="Foreground"
                            Value="{DynamicResource ResourceKey={x:Static SystemColors.GrayTextBrushKey}}" />
                    <Setter x:Uid="Setter_81"
                            Property="Text"
                            Value="{Binding Path=HintText, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}" />
                </DataTrigger>
                <DataTrigger x:Uid="DataTrigger_2"
                             Binding="{Binding Path=Text.Length, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}"
                             Value="0">
                    <Setter x:Uid="Setter_83"
                            Property="FontStyle"
                            Value="Italic" />
                    <Setter x:Uid="Setter_84"
                            Property="Foreground"
                            Value="{DynamicResource ResourceKey={x:Static SystemColors.GrayTextBrushKey}}" />
                    <Setter x:Uid="Setter_85"
                            Property="Text"
                            Value="{Binding Path=HintText, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}" />
                </DataTrigger>
                <DataTrigger x:Uid="DataTrigger_11"
                             Binding="{Binding Path=IsSupportedExpression, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}"
                             Value="False">
                    <Setter x:Uid="Setter_86"
                            Property="FontStyle"
                            Value="Italic" />
                    <Setter x:Uid="Setter_87"
                            Property="Foreground"
                            Value="{DynamicResource ResourceKey={x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Uid="Style_4"
               x:Key="errorStyle"
               TargetType="{x:Type materialIcons:MaterialIcon}">
            <Setter x:Uid="Setter_47"
                    Property="Visibility"
                    Value="Collapsed" />
            <Setter x:Uid="Setter_49"
                    Property="HorizontalAlignment"
                    Value="Right" />
            <Setter x:Uid="Setter_86"
                    Property="VerticalAlignment"
                    Value="Top" />
            <Setter x:Uid="Setter_87"
                    Property="ToolTipService.ShowOnDisabled"
                    Value="True" />
            <!-- Бейдж ошибки — глиф палитры, а не пустая рамка: Kind=Error (залитый круг с «!»).
                 Красный — единственный не-нейтральный цвет палитры, семантика ошибки. -->
            <Setter Property="Kind"
                    Value="Error" />
            <Setter x:Uid="Setter_53"
                    Property="Width"
                    Value="12" />
            <Setter x:Uid="Setter_54"
                    Property="Height"
                    Value="12" />
            <Setter x:Uid="Setter_55"
                    Property="Margin"
                    Value="2,2,2,0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Studio.CloseHoverBackground}" />
            <Style.Triggers>
                <DataTrigger x:Uid="DataTrigger_9"
                             Binding="{Binding Path=HasValidationError}"
                             Value="True">
                    <Setter x:Uid="Setter_50"
                            Property="Visibility"
                            Value="Visible" />
                    <Setter x:Uid="Setter_51"
                            Property="ToolTip"
                            Value="{Binding Path=ValidationErrorMessage}" />
                    <Setter x:Uid="Setter_88"
                            Property="ToolTipService.InitialShowDelay"
                            Value="100" />
                    <Setter x:Uid="Setter_89"
                            Property="ToolTipService.ShowDuration"
                            Value="3600000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Uid="Style_6"
               x:Key="borderStyle"
               TargetType="{x:Type Border}">
            <Style.Triggers>
                <DataTrigger x:Uid="DataTrigger_12"
                             Binding="{Binding Path=IsEnabled}"
                             Value="False">
                    <Setter x:Uid="Setter_106"
                            Property="Background"
                            Value="{DynamicResource WorkflowViewElementBackground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Uid="Style_5"
               x:Key="editorStyle"
               TargetType="{x:Type Control}">
            <Setter x:Uid="Setter_90"
                    Property="Margin"
                    Value="4,2,4,2" />
            <Setter x:Uid="Setter_57"
                    Property="FlowDirection"
                    Value="LeftToRight" />
            <Setter x:Uid="Setter_58"
                    Property="FontFamily"
                    Value="{Binding Path=FontFamily}" />
            <Setter x:Uid="Setter_59"
                    Property="FontSize"
                    Value="{Binding Path=FontSize}" />
            <Setter x:Uid="Setter_60"
                    Property="FontStretch"
                    Value="{Binding Path=FontStretch}" />
            <Setter x:Uid="Setter_61"
                    Property="FontStyle"
                    Value="{Binding Path=FontStyle}" />
            <Setter x:Uid="Setter_62"
                    Property="FontWeight"
                    Value="{Binding Path=FontWeight}" />
            <Setter x:Uid="Setter_64"
                    Property="Language"
                    Value="{Binding Path=Language}" />
            <Setter x:Uid="Setter_65"
                    Property="SnapsToDevicePixels"
                    Value="{Binding Path=SnapsToDevicePixels}" />
            <Setter x:Uid="Setter_92"
                    Property="Height"
                    Value="{Binding Path=Height}" />
            <Setter x:Uid="Setter_94"
                    Property="MinHeight"
                    Value="{Binding Path=MinHeight}" />
            <Setter x:Uid="Setter_95"
                    Property="MaxHeight"
                    Value="{Binding Path=MaxHeight}" />
            <Setter x:Uid="Setter_96"
                    Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter x:Uid="Setter_98"
                    Property="VerticalAlignment"
                    Value="{Binding Path=VerticalContentAlignment}" />
            <Setter x:Uid="Setter_99"
                    Property="ClipToBounds"
                    Value="{Binding Path=ClipToBounds, RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}" />
        </Style>

        <DataTemplate x:Uid="DataTemplate_1"
                      x:Key="textblock">
            <Grid x:Uid="Grid_1"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type Control}, AncestorLevel=2}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Uid="ColumnDefinition_1"
                                      Width="*" />
                    <ColumnDefinition x:Uid="ColumnDefinition_2"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Uid="Border_2"
                        Style="{StaticResource borderStyle}"
                        Grid.Column="0"
                        BorderBrush="{DynamicResource Studio.Separator}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="1"
                        HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="TextBlock_2"
                               Style="{StaticResource textBlockStyle}"
                               AutomationProperties.AutomationId="{Binding Path=Name}"
                               Focusable="True"
                               GotKeyboardFocus="OnGotTextBlockFocus"
                               Loaded="OnTextBlockLoaded"
                               MouseLeftButtonDown="OnTextBlockMouseLeftButtonDown"
                               Name="expresionTextBlock" />
                </Border>
                <materialIcons:MaterialIcon x:Uid="Rectangle_2"
                           Style="{StaticResource errorStyle}"
                           Grid.Column="1" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Uid="DataTemplate_3"
                      x:Key="expressioneditor">
            <Grid x:Uid="Grid_3"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type Control}, AncestorLevel=2}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Uid="ColumnDefinition_5"
                                      Width="*" />
                    <ColumnDefinition x:Uid="ColumnDefinition_6"
                                      Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Uid="Border_5"
                        Grid.Column="0"
                        CornerRadius="1"
                        BorderBrush="{DynamicResource Studio.Separator}"
                        BorderThickness="1,1,1,1"
                        Loaded="OnEditorLoaded"
                        Unloaded="OnEditorUnloaded"
                        Margin="0,0,0,0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        GotKeyboardFocus="OnGotEditingFocus"
                        Background="{DynamicResource DesignerViewBackground}"
                        MouseRightButtonDown="OnEditorBorderRightClick" />
                <!--<editor:RoslynCodeEditor x:Name="roslynCodeEditor"
                                         Initialized="OnItemInitialized"
                                         Loaded="OnItemLoaded"
                                         PreviewKeyDown="OnEditorKeyDown"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         WordWrap="False"
                                         HorizontalScrollBarVisibility="Hidden"
                                         VerticalScrollBarVisibility="Disabled"
                                         BorderThickness="1"
                                         BorderBrush="Black"/>-->
                <materialIcons:MaterialIcon x:Uid="Rectangle_6"
                           Grid.Column="1"
                           Style="{StaticResource errorStyle}" />
            </Grid>
        </DataTemplate>

    </sape:TextualExpressionEditor.Resources>
    <Grid x:Name="grid"
          x:Uid="Grid_3"
          DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RoslynExpressionEditor}}}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type Control}, AncestorLevel=2}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Uid="ColumnDefinition_5"
                              Width="*" />
            <ColumnDefinition x:Uid="ColumnDefinition_6"
                              Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border BorderThickness="1"
                Margin="2"
                BorderBrush="{DynamicResource Studio.Separator}"
                Grid.Column="0"
                x:Name="border"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ContextMenuOpening="OnBorderContextMenuOpening"
                MouseRightButtonDown="OnMainBorderRightClick">
            <ContentPresenter x:Name="innerControl"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
        </Border>
        <materialIcons:MaterialIcon x:Uid="Rectangle_6"
                   Grid.Column="1"
                   Style="{StaticResource errorStyle}" />
    </Grid>
</sape:TextualExpressionEditor>