<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
    <!-- Marker used by AppSettings.ApplyTheme to locate and swap this dictionary. -->
    <SolidColorBrush x:Key="Studio.ThemeMarker" Color="Transparent" />

    <SolidColorBrush x:Key="Studio.WindowBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="Studio.MenuBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="Studio.MenuForeground" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Studio.ToolbarBackground" Color="#333337" />
    <SolidColorBrush x:Key="Studio.ToolbarForeground" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Studio.ToolbarBorder" Color="#3F3F46" />
    <SolidColorBrush x:Key="Studio.ToolbarHoverBackground" Color="#3E3E42" />
    <SolidColorBrush x:Key="Studio.ToolbarPressedBackground" Color="#264F78" />
    <SolidColorBrush x:Key="Studio.ToolbarCheckedBackground" Color="#3364B5F6" />

    <!-- Заголовок окна (кастомный title bar) -->
    <SolidColorBrush x:Key="Studio.TitleBarBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="Studio.TitleBarForeground" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Studio.TitleBarButtonHoverBackground" Color="#3E3E42" />
    <SolidColorBrush x:Key="Studio.TitleBarButtonCloseHoverBackground" Color="#E81123" />
    <SolidColorBrush x:Key="Studio.TitleBarButtonCloseForeground" Color="#FFFFFF" />

    <!-- Переопределение системных кистей, чтобы выпадающее меню следовало теме -->
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.MenuBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.MenuTextBrushKey}" Color="#F1F1F1" />
</ResourceDictionary>
