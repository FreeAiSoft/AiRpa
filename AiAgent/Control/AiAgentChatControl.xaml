<UserControl x:Class="AiAgent.Control.AiAgentChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AiAgent.Control"
             xmlns:converters="clr-namespace:AiAgent.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <converters:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Стиль для сообщений -->
        <DataTemplate x:Key="MessageTemplate">
            <Border HorizontalAlignment="{Binding Role, Converter={StaticResource MessageAlignmentConverter}}"
                    Background="{Binding Role, Converter={StaticResource MessageBackgroundConverter}}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="5,2"
                    MaxWidth="600">
                <StackPanel>
                    <TextBlock Text="{Binding Role}"
                               FontWeight="Bold"
                               FontSize="11"
                               Opacity="0.7"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Content, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               TextTrimming="None"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                   FontSize="10"
                                   Opacity="0.6"/>
                        <TextBlock Text=" • Печатает..."
                                   FontSize="10"
                                   Opacity="0.6"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Панель управления -->
            <RowDefinition Height="*"/>     <!-- Область сообщений -->
            <RowDefinition Height="Auto"/>  <!-- Строка статуса -->
            <RowDefinition Height="Auto"/>  <!-- Поле ввода -->
        </Grid.RowDefinitions>
        
        <!-- Панель управления -->
        <Border Grid.Row="0" 
                Background="#F5F5F5" 
                BorderBrush="#DDDDDD" 
                BorderThickness="0,0,0,1" 
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Модель:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontWeight="SemiBold"/>
                    <ComboBox Width="250"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="DisplayName"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        Content="🔄 Обновить" 
                        Command="{Binding LoadModelsCommand}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Cursor="Hand"/>
                
                <Button Grid.Column="2" 
                        Content="🗑️ Очистить" 
                        Command="{Binding ClearChatCommand}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Cursor="Hand"/>
                
                <Button Grid.Column="3" 
                        Content="💾 Сохранить" 
                        Command="{Binding SaveConversationCommand}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Cursor="Hand"/>
                
                <Button Grid.Column="4" 
                        Content="⏹️ Остановить" 
                        Command="{Binding CancelGenerationCommand}"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Background="#FFE0E0"
                        BorderBrush="#FF6B6B"
                        BorderThickness="1"
                        Cursor="Hand"
                        Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
        
        <!-- Область сообщений -->
        <Border Grid.Row="1" 
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="MessageScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource MessageTemplate}"
                              VirtualizingPanel.IsVirtualizing="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Строка статуса -->
        <Border Grid.Row="2" 
                Background="#F9F9F9" 
                BorderBrush="#DDDDDD" 
                BorderThickness="0,0,0,1"
                Padding="10,5"
                Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="11" 
                       Foreground="#666666"/>
        </Border>
        
        <!-- Поле ввода -->
        <Border Grid.Row="3" 
                Background="White" 
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" 
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="2">
                    <TextBox x:Name="InputTextBox"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="100"
                             BorderThickness="0"
                             Padding="8"
                             FontSize="13"
                             IsEnabled="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" 
                                       Modifiers="Control" 
                                       Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
                
                <Button Grid.Column="1" 
                        Content="📤 Отправить" 
                        Command="{Binding SendMessageCommand}"
                        Width="120"
                        Height="40"
                        Margin="8,0,0,0"
                        Background="#007ACC"
                        Foreground="White"
                        BorderBrush="#005A9E"
                        BorderThickness="1"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="4"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0094DC"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#005A9E"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCCCCC"/>
                                                <Setter Property="BorderBrush" Value="#AAAAAA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>
