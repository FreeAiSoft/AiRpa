<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RPA.NuGet</RootNamespace>
    <AssemblyName>RPA.NuGet</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- NuGet.Client: versioning (resolver), packaging (nuspec/archive) and protocol
         (search/metadata of the selected package source). The deprecated NuGet.Resolver package is replaced
         by NuGet.Versioning-based resolution in NuGetVersionResolver. -->
    <PackageReference Include="NuGet.Versioning" Version="6.3.4" />
    <PackageReference Include="NuGet.Packaging" Version="6.3.4" />
    <PackageReference Include="NuGet.Protocol" Version="6.3.4" />
    <!-- Иконки панели (шеврон комбобокса, кнопки строки) — та же версия, что в студии. -->
    <PackageReference Include="Material.Icons.WPF" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестам нужен конструктор панели с подставленной моделью (источник 127.0.0.1, без сети). -->
    <InternalsVisibleTo Include="AiRpaStudio.Tests" />
  </ItemGroup>

</Project>
