<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <!--
        Стили панели «NuGet».

        Правила (docs\NuGet_Panel_Redesign_Plan.md §2.2):
        · прямые углы — CornerRadius="0" (как у панели «Свойства», см. PropertyWindowStyleHelper);
        · один фон — Studio.Surface; зоны различает hairline 1px Studio.Separator;
        · ноль акцента — состояние передаётся яркостью Studio.Hover/Studio.Selected;
        · цвета только ключами палитры студии (hex и named-цвета запрещены стражем
          AiRpaStudio.Tests\NuGetPanelThemeTests.cs);
        · шрифт — только Studio.FontFamily (StudioFontTests).
    -->

    <!-- ======================= Вкладки Browse / Installed / Updates ======================= -->

    <Style x:Key="NuGet.TabButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Studio.SeparatorStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Кнопки ======================= -->

    <!-- Прозрачная кнопка с иконкой (очистка поиска, шестерня, «назад» в узком режиме). -->
    <Style x:Key="NuGet.IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Studio.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Большая кнопка действия (Install / Update / Downgrade / Uninstall): серая, как в VS 2026. -->
    <Style x:Key="NuGet.ActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource Studio.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Studio.SeparatorStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Studio.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Маленькая кнопка на плашке пакета (Install/Update/Uninstall по наведению мыши). -->
    <Style x:Key="NuGet.RowButtonStyle" TargetType="Button" BasedOn="{StaticResource NuGet.ActionButtonStyle}">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="FontSize" Value="11" />
        <!-- Видимость задаётся только триггером плашки: локальное значение в шаблоне
             перебило бы DataTemplate-триггер (у локального значения приоритет выше). -->
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Ссылка (Project URL, Report Abuse, Configure): подчёркнутый текст без рамки и фона. -->
    <Style x:Key="NuGet.LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="LinkText" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Оверлей «Package sources» ======================= -->

    <Style x:Key="NuGet.OverlayCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource NuGet.CheckBoxStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NuGet.OverlayRowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="OverlayRowBorder" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OverlayRowBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OverlayRowBorder" Property="Background" Value="{DynamicResource Studio.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NuGet.OverlayTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Studio.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Studio.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Studio.Separator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Background="Transparent"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource Studio.SeparatorStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Поле поиска ======================= -->

    <Style x:Key="NuGet.SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Studio.Selected}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  Background="Transparent"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= CheckBox ======================= -->

    <Style x:Key="NuGet.CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="CheckBorder"
                                Width="14"
                                Height="14"
                                CornerRadius="0"
                                BorderBrush="{DynamicResource Studio.SeparatorStrong}"
                                BorderThickness="1"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckGlyph"
                                  Width="8"
                                  Height="6"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource Studio.Foreground}"
                                  StrokeThickness="1.4"
                                  Data="M 0,3 L 3,6 L 8,0"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Studio.ForegroundMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= ComboBox (источник, версия) ======================= -->

    <Style x:Key="NuGet.ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Studio.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Внутренние ToggleButton шаблонов ================= -->

    <!--
        Геометрия ToggleButton, которые живут ВНУТРИ наших шаблонов (коробка комбобокса, шапка
        Expander «Options»). Стиль задаётся явно, потому что App.xaml подключает
        MaterialDesign2.Defaults.xaml, а там есть НЕЯВНЫЙ стиль ToggleButton — переключатель с
        жёсткой Width = 34 (правило зафиксировано в AGENTS.md: «Внутренние ToggleButton в шаблонах
        (OutlinedComboBoxStyle, ReasoningExpanderStyle) обязаны задавать Style явно»).
        Пока у DropDownToggle был только локальный Template, ширину 34 ему задавал чужой неявный
        стиль: коробка комбобокса физически была 34 px, подпись в неё не влезала, и правки
        HorizontalAlignment, колонок Grid и TextTrimming ничего не меняли. В тестах дефект не
        ловился: панель хостится без App.xaml, то есть без неявного стиля MaterialDesign.
        Width = Auto допустим (LengthConverter отдаёт NaN, FrameworkElement.Width NaN принимает),
        MinWidth = Auto — нет (NaN валит Style.Seal), поэтому 0.
    -->
    <Style x:Key="NuGet.StretchedToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
    </Style>

    <Style x:Key="NuGet.ComboBoxStyle" TargetType="ComboBox">
        <!-- Ширина — по содержимому: растянутый на всю колонку комбобокс обрезал подпись версии. -->
        <!-- Потолок ширины 150px: в поле длинная подпись обрезается многоточием, но видна целиком
             в выпадающем списке (popup не уже ActualWidth, строки списка меряются по содержимому). -->
        <Setter Property="MaxWidth" Value="150" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Studio.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Studio.Separator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NuGet.ComboBoxItemStyle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Всё содержимое ВНУТРИ ToggleButton: иначе прозрачный слой клика поверх
                             визуала отбирает у ComboBox захват мыши, IsChecked откатывается в false и
                             список не раскрывается. -->
                        <ToggleButton x:Name="DropDownToggle"
                                      Style="{StaticResource NuGet.StretchedToggleButtonStyle}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{DynamicResource Studio.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Studio.Separator}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Шеврон — иконка MaterialDesign и стоит слева, по центру по
                                                 вертикали (как в дереве/списках VS). -->
                                            <materialIcons:MaterialIcon Grid.Column="0"
                                                                        Kind="ChevronDown"
                                                                        Width="12"
                                                                        Height="12"
                                                                        Margin="6,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Studio.ForegroundMuted}" />

                                            <!-- Текст выбранного элемента. Именно TextBlock, а не ContentPresenter:
                                                 у комбобокса с DisplayMemberPath SelectionBoxItem приходит пустым,
                                                 из-за чего поле выглядело пустым и «сжатым». TextBlock берёт
                                                 ToString() выбранного элемента (у моделей он возвращает подпись)
                                                 и честно измеряет текст, поэтому ширина растёт по содержимому.
                                                 Foreground задан явно: внутри шаблона ToggleButton текст
                                                 наследует чёрный цвет и в тёмной теме пропадает. -->
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Studio.Foreground}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Studio.SeparatorStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="False"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource Studio.Surface}"
                                    BorderBrush="{DynamicResource Studio.SeparatorStrong}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Иконочная кнопка плашки пакета: место под неё выделено всегда, поэтому появление
         кнопки по наведению не сдвигает остальные элементы строки. -->
    <Style x:Key="NuGet.RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NuGet.IconButtonStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <!-- Видимость задаётся только триггером плашки: локальное значение в шаблоне перебило бы
             DataTemplate-триггер (у локального значения приоритет выше). -->
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- ======================= Expander «Options» ======================= -->

    <!-- Шапка-переключатель — кнопка БЕЗ фона: наведение, нажатие и раскрытие не меняют ни фон,
         ни цвет подписи, ни цвет иконки. Триггеров IsMouseOver/IsPressed здесь нет намеренно
         (замечание приёмки: «шеврон не должен менять цвет при наведении»). Раскрытое состояние
         видно только по самому глифу: ChevronRight → ChevronDown. -->
    <Style x:Key="NuGet.OptionsExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle"
                                      Style="{StaticResource NuGet.StretchedToggleButtonStyle}"
                                      Focusable="False"
                                      Cursor="Hand"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="0" Padding="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Иконка MaterialDesign вместо самодельных Path: цвет постоянный
                                                 (Studio.ForegroundMuted), меняется только сам глиф. -->
                                            <materialIcons:MaterialIcon x:Name="ChevronIcon"
                                                                        Kind="ChevronRight"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Margin="0,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Studio.ForegroundMuted}" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ChevronIcon" Property="Kind" Value="ChevronDown" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ExpandContent" Visibility="Collapsed" Margin="14,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Список пакетов ======================= -->

    <Style x:Key="NuGet.PackageListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0">
                        <ScrollViewer Focusable="False"
                                      Padding="0"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NuGet.PackageRowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowBorder"
                            Background="Transparent"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Studio.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Studio.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Прогресс ======================= -->

    <Style x:Key="NuGet.ProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Studio.Separator}" />
        <Setter Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="0" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Текст ======================= -->

    <!-- Подпись метаданных («Version:», «Author(s):», «Tags:»). -->
    <Style x:Key="NuGet.LabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="NuGet.ValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="NuGet.MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Studio.ForegroundMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
