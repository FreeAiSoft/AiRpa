<configuration>
  <!-- Public nuget.org source; the Agent.* packages are published there (AgentToolkit). -->
  <packageSources>
    <clear />
    <add key="local" value="nuget_local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AgentShared\feed" value="C:\Users\Maxxx\source\repos\AgentShared\feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="AgentToolkit" />
      <package pattern="AgentToolkit.Wpf" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>