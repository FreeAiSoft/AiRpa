<Project Sdk="Microsoft.NET.Sdk">

  <!-- OR-03: упаковка робота — «собрать проект → robot.zip + manifest.json». Отдельный проект, а не код
       внутри `RpaRunner`: раннер по контракту `OR-02` **ничего не собирает** и не имеет права тянуть
       MSBuild (страж `RunnerSourceGuardTests`). Здесь MSBuild как раз нужен, поэтому упаковка живёт
       отдельно и подключается студией (`OR-14`), сервером (`OR-05`) и CLI `RpaPack`.
       Цель `netstandard2.0`: набор вызывающих — и 4.7.2, и будущий Blazor-сервер. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>RPA.Packaging</RootNamespace>
    <AssemblyName>Rpa.RobotPackaging</AssemblyName>
    <Deterministic>true</Deterministic>
    <Description>Сборка проекта робота и упаковка в robot.zip с манифестом, хэшем и локальным кэшем (OR-03).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rpa.Orchestrator.Contracts\Rpa.Orchestrator.Contracts.csproj" />
    <!-- Локатор MSBuild один на всё решение (`CP-04`): второй список «где искать MSBuild.exe»
         разошёлся бы со студийным молча. Отсюда только он, без агентских инструментов. -->
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
  </ItemGroup>

</Project>
