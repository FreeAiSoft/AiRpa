<mah:MetroWindow x:Class="ProxyChecker.Views.ProxiesView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:ProxyChecker.Views"
                 xmlns:converters="clr-namespace:ProxyChecker.Converters"
                 mc:Ignorable="d"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="ProxiesView"
                 Height="550"
                 Width="1100"
                 WindowTransitionsEnabled="False"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProxyChecker;component/Dictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:MultiConverter x:Key="MultiConverter" />
            <converters:InvertVisibilityConverter x:Key="InvertVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.Resources>

            <DataTemplate x:Key="ProxyButtons">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource lang_proxy_checker_datagrid_CheckButton}"
                            Margin="3,0,0,0"
                            Style="{StaticResource MahApps.Styles.Button}"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.Cmd}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource MultiConverter}">
                                <Binding Source="CheckProxyCommand" />
                                <Binding RelativeSource="{RelativeSource Self}"
                                         Path="DataContext" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Style="{StaticResource MahApps.Styles.Button}"
                            Margin="3,0,0,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.Cmd}">
                        <iconPacks:PackIconIonicons Kind="CloseMD"
                                                    Width="14"
                                                    Height="14" />
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource MultiConverter}">
                                <Binding Source="DelProxyCommand" />
                                <Binding RelativeSource="{RelativeSource Self}"
                                         Path="DataContext" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Style="{StaticResource MahApps.Styles.Button}"
                            Margin="3,0,0,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=DetailsVisibility, Converter={StaticResource InvertVisibilityConverter}}"
                            Click="ShowDetailsClick">
                        <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                    Width="14"
                                                    Height="14" />
                    </Button>
                    <Button Style="{StaticResource MahApps.Styles.Button}"
                            Margin="3,0,0,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=DetailsVisibility}"
                            Click="HideDetailsClick">
                        <iconPacks:PackIconMaterial Kind="ChevronUp"
                                                    Width="14"
                                                    Height="14" />
                    </Button>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ShowProxyDetailsButton">
                
            </DataTemplate>

        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Border BorderThickness="1"
                BorderBrush="{StaticResource MahApps.Brushes.Accent}"
                Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal"
                        Margin="10">
                <TextBlock Text="{DynamicResource lang_proxy_checker_ExternalIP}"
                           FontFamily="Roboto"
                           FontSize="16"
                           FontWeight="Medium" />
                <TextBlock FontFamily="Roboto"
                           FontSize="16"
                           Margin="20,0"
                           FontWeight="Medium"
                           Text="{Binding OwnIp, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OwnIp}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontFamily="Roboto"
                           FontSize="16"
                           FontWeight="Medium"
                           Margin="20,0"
                           Text="{DynamicResource lang_proxy_checker_Undefined}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OwnIp}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ProxiesColl}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ScrollViewer.CanContentScroll="False"
                  BorderThickness="1"
                  RowDetailsVisibilityMode="Collapsed">
            <DataGrid.Resources>
                <Style BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}"
                       TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background"
                            Value="{DynamicResource MahApps.Brushes.ContextMenu.Background}" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Host}"
                                    DisplayIndex="0"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Host" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Port}"
                                    DisplayIndex="1"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_port}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Login}"
                                    DisplayIndex="2"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_login}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Pwd}"
                                    DisplayIndex="3"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_pwd}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ProxyProtocol}"
                                    DisplayIndex="4"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_type}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Anonimity}"
                                    DisplayIndex="5"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_anonimity}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Status}"
                                    DisplayIndex="6"
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_state}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Comment}"
                                    DisplayIndex="7"
                                    IsReadOnly="False"
                                    Width="180">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource lang_proxy_checker_datagrid_header_comment}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header=""
                                        Width="135"
                                        DisplayIndex="8"
                                        CellTemplate="{StaticResource ProxyButtons}" />
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource MahApps.Brushes.Gray2}">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExternalIp}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="5">
                                <Run Text="{DynamicResource lang_proxy_checker_datagrid_rowdetails_ExternalIpPort}"
                                     FontSize="13"
                                     FontWeight="DemiBold" />
                                <LineBreak />
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}:{1}">
                                            <Binding Path="ExternalIp" />
                                            <Binding Path="ExternalPort" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <LineBreak />
                                <Run Text="Reverse DNS:" />
                                <Run Text="{Binding IpInfo.Reverse}" />
                            </TextBlock>
                            <TextBlock Margin="5"
                                       Grid.Column="1">
                                <Run Text="Geo"
                                     FontSize="13"
                                     FontWeight="DemiBold" />
                                <LineBreak />
                                <Run Text="{DynamicResource lang_proxy_checker_datagrid_rowdetails_Country}" />
                                <Run Text="{Binding IpInfo.Country}" />
                                <LineBreak />
                                <Run Text="{DynamicResource lang_proxy_checker_datagrid_rowdetails_City}" />
                                <Run Text="{Binding IpInfo.City}" />
                                <LineBreak />
                                <Run Text="lat:" />
                                <Run Text="{Binding IpInfo.Lat}" />
                                <LineBreak />
                                <Run Text="lon:" />
                                <Run Text="{Binding IpInfo.Lon}" />
                            </TextBlock>
                            <TextBlock Margin="5"
                                       Grid.Column="2">
                                <Run Text="Timezone"
                                     FontSize="13"
                                     FontWeight="DemiBold" />
                                <LineBreak />
                                <Run Text="{Binding IpInfo.Timezone}" />
                                <LineBreak />
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}offset: {0} s ({1} h)">
                                            <Binding Path="IpInfo.Offset" />
                                            <Binding Path="IpInfo.TimeOffset"
                                                     Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </TextBlock>
                            <TextBlock Margin="5"
                                       Grid.Column="3">
                                <Run Text="Organization"
                                     FontSize="13"
                                     FontWeight="DemiBold" />
                                <LineBreak />
                                <Run Text="{DynamicResource lang_proxy_checker_datagrid_rowdetails_Provider}" />
                                <Run Text="{Binding IpInfo.Isp}" />
                                <LineBreak />
                                <Run Text="{DynamicResource lang_proxy_checker_datagrid_rowdetails_Organization}" />
                                <Run Text="{Binding IpInfo.Org}" />
                                <LineBreak />
                                <Run Text="As:" />
                                <Run Text="{Binding IpInfo.As}" />
                                <LineBreak />
                                <Run Text="Asname:" />
                                <Run Text="{Binding IpInfo.Asname}" />
                            </TextBlock>
                            <TextBlock Margin="5"
                                       Grid.Column="4">
                                <Run Text="{DynamicResource lang_proxy_checker_datagrid_rowdetails_IpType}"
                                     FontSize="13"
                                     FontWeight="DemiBold" />
                                <LineBreak />
                                <Run Text="mobile:" />
                                <Run Text="{Binding IpInfo.Mobile}" />
                                <LineBreak />
                                <Run Text="proxy:" />
                                <Run Text="{Binding IpInfo.Proxy}" />
                                <LineBreak />
                                <Run Text="hosting:" />
                                <Run Text="{Binding IpInfo.Hosting}" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    Margin="0,5">
            <ComboBox x:Name="httpProxyComboBox" 
                      SelectedIndex="{Binding ProxyFormatIndex}"
                      FontSize="14">
                <ComboBoxItem Content="ip:port:login:password"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="ip:port@login:password"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="ip:port|login:password"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="login:password@ip:port"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="login:password:ip:port"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="ip:port"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="domen:port"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="login:password@domen:port"
                              HorizontalAlignment="Left"
                              Width="209" />
            </ComboBox>
            <ComboBox x:Name="socksProxyComboBox"
                      SelectedIndex="0"
                      Visibility="Collapsed"
                      FontSize="14">
                <ComboBoxItem Content="ip:port"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="domen:port"
                              HorizontalAlignment="Left"
                              Width="209" />
                <ComboBoxItem Content="login:password@domen:port"
                              HorizontalAlignment="Left"
                              Width="209" />
            </ComboBox>
            <ComboBox SelectedIndex="{Binding ProxyTypeIndex}"
                      Width="80"
                      Margin="5,0"
                      SelectionChanged="ComboBox_SelectionChanged"
                      SelectedValuePath="Content">
                <ComboBoxItem  Content="HTTP" />
                <ComboBoxItem  Content="SOCKS5" />
            </ComboBox>
        </StackPanel>
        <TextBox x:Name="proxyListTextBox"
                 Grid.Row="3"
                 Text="{Binding TextProxyList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 mah:TextBoxHelper.Watermark="ip:port:login:password&#x0a;ip:port:login:password&#x0a;ip:port:login:password&#x0a;ip:port:login:password&#x0a;"
                 TextChanged="proxyListTextBox_TextChanged" />
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,5,0,0">
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_AddProxy}"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Command="{Binding Cmd}"
                    CommandParameter="AddProxyListCommand" />
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_AddProxyFromFile}"
                    Margin="5,0,0,0"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Command="{Binding Cmd}"
                    CommandParameter="AddProxyFromFileCommand" />
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_CheckAllProxy}"
                    Margin="5,0,0,0"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Command="{Binding Cmd}"
                    CommandParameter="CheckProxyAllCommand" />
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_DeleteAllProxy}"
                    Margin="5,0,0,0"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Command="{Binding Cmd}"
                    CommandParameter="DelAllProxyCommand" />
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_Import}"
                    Margin="5,0,0,0"
                    Command="{Binding Cmd}"
                    CommandParameter="ImportProxy"
                    Style="{StaticResource MahApps.Styles.Button}" />
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_Export}"
                    Margin="5,0,0,0"
                    Command="{Binding Cmd}"
                    CommandParameter="ExportProxy"
                    Style="{StaticResource MahApps.Styles.Button}" />
            <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_BuyProxy}"
                    Margin="5,0,0,0"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Command="{Binding Cmd}"
                    CommandParameter="BuyProxyCommand" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
