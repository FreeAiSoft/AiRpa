<Window x:Class="ProxyChecker.Views.ProxyImport"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:ProxyChecker.Views"
                 mc:Ignorable="d"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 Title="Proxy import"
                 Height="90"
                 Width="487">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProxyChecker;component/Dictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <StackPanel>
            <StackPanel HorizontalAlignment="Left"
                        Height="30"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Width="500">
                <Label Content="PROXYS.IO" />
                <TextBox Text="{Binding ProxyMod.ProxyioKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="23"
                         Width="330"
                         TextWrapping="NoWrap" />
                <Button Content="{DynamicResource lang_proxy_checker_bottom_buttons_Import}"
                        Click="Button_Click"
                        Margin="5,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
