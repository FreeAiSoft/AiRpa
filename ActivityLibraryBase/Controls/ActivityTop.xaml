<UserControl x:Class="ActivityLibraryBase.Controls.ActivityTop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ActivityLibraryBase.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:localResx="clr-namespace:ActivityLibraryBase.Resources">

    <Grid Width="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="isEnabledCheckBox"
                  ToolTip="{x:Static localResx:ActivityLibraryBaseResorces.activities_base_on_off}"
                  IsChecked="{Binding Path=ModelItem.IsEnabled, Mode=TwoWay}" 
                  Checked="IsEnabledCheckBox_Checked"
                  Unchecked="IsEnabledCheckBox_Unchecked"/>
        <!--
            Подпись активности: цвет берётся из палитры темизатора дизайнера (он ставит локальное значение
            на TextBlock), поэтому Foreground здесь не задаётся. Отключённая активность показывается
            прозрачностью, а не цветом: зашитый цвет (прежняя кисть Black)
            в тёмной теме не читался — чёрные буквы на тёмной плите.
        -->
        <TextBlock Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center"
                   Grid.Column="1"
                   FontWeight="Black">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=isEnabledCheckBox}"
                                     Value="False">
                            <Setter Property="Opacity"
                                    Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
