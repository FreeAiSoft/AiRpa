<UserControl x:Class="ActivityLibraryBase.Controls.ActivityTop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ActivityLibraryBase.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:conv="clr-namespace:ActivityLibraryBase.Converters"
             xmlns:localResx="clr-namespace:ActivityLibraryBase.Resources">
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Width="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="isEnabledCheckBox"
                  ToolTip="{x:Static localResx:ActivityLibraryBaseResorces.activities_base_on_off}"
                  IsChecked="{Binding Path=ModelItem.IsEnabled, Mode=TwoWay}" 
                  Checked="IsEnabledCheckBox_Checked"
                  Unchecked="IsEnabledCheckBox_Unchecked"/>
        <TextBlock Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{Binding ElementName=isEnabledCheckBox, Path=IsChecked, Converter={StaticResource BoolToColorConverter}}"
                   HorizontalAlignment="Center"
                   Grid.Column="1"
                   FontWeight="Black" />
    </Grid>
</UserControl>
