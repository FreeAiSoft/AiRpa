<Project Sdk="Microsoft.NET.Sdk">

  <!-- OR-03: `RpaPack.exe` — упаковка робота в `robot.zip`. Отдельный инструмент, а не режим раннера:
       раннер (`OR-02`) исполняет и ничего не собирает, упаковщик собирает и ничего не исполняет.
       net472 (`CP-10`) — чтобы упаковка работала на машине разработчика и на агенте без студии. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>RpaPack</RootNamespace>
    <AssemblyName>RpaPack</AssemblyName>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Description>Упаковка робота в robot.zip с манифестом, хэшем и локальным кэшем (OR-03).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rpa.RobotPackaging\Rpa.RobotPackaging.csproj" />
  </ItemGroup>

</Project>
