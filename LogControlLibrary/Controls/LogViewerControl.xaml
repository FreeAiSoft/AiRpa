<UserControl x:Class="LogControlLibrary.Controls.LogViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:LogControlLibrary.Converters"
             xmlns:models="clr-namespace:LogControlLibrary.Models"
             xmlns:primitives="http://schemas.microsoft.com/winfx/2006/xaml/presentation/primitives"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             FontFamily="{DynamicResource Studio.FontFamily}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <!-- Конвертеры -->
        <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        <converters:LogLevelToBackgroundConverter x:Key="LogLevelToBackgroundConverter"/>
        <converters:LogLevelToHoverConverter x:Key="LogLevelToHoverConverter"/>
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
        <converters:MessageColumnWidthConverter x:Key="MessageColumnWidthConverter"/>

        <!-- Стили для кнопок -->
        <Style TargetType="Button"
               x:Key="ToolbarButtonStyle">
            <Setter Property="Margin"
                    Value="2" />
            <Setter Property="Padding"
                    Value="8,4" />
            <Setter Property="MinWidth"
                    Value="75" />
            <Setter Property="Height"
                    Value="28" />
        </Style>

        <!-- Стиль для кнопок уровней логирования -->
        <Style TargetType="ToggleButton"
               x:Key="LogLevelToggleButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="BorderThickness"
                    Value="1,1,0,1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.Separator}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.Selected}" />
                </Trigger>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для первой кнопки (левая граница) -->
        <Style TargetType="ToggleButton"
               x:Key="LogLevelToggleButtonFirstStyle"
               BasedOn="{StaticResource LogLevelToggleButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <!-- Стиль для последней кнопки (правая граница) -->
        <Style TargetType="ToggleButton"
               x:Key="LogLevelToggleButtonLastStyle"
               BasedOn="{StaticResource LogLevelToggleButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1,1,1,1" />
        </Style>

        <!-- Стиль для обычных кнопок в стиле toggle -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonStyle">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="BorderThickness"
                    Value="1,1,0,1" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Studio.Separator}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.Hover}" />
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Studio.Selected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для последней обычной кнопки -->
        <Style TargetType="Button"
               x:Key="LogLevelButtonLastStyle"
               BasedOn="{StaticResource LogLevelButtonStyle}">
            <Setter Property="BorderThickness"
                    Value="1,1,1,1" />
        </Style>

        <!-- Стиль для CheckBox фильтров -->
        <Style TargetType="CheckBox" x:Key="FilterCheckBoxStyle">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Стиль для элементов лога -->
        <Style TargetType="ListViewItem" x:Key="LogEntryItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{Binding Level, Converter={StaticResource LogLevelToBackgroundConverter}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding Level, Converter={StaticResource LogLevelToHoverConverter}}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Studio.Selected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стиль для заголовков GridView -->
        <Style TargetType="GridViewColumnHeader" x:Key="CustomGridViewColumnHeaderStyle">
            <Setter Property="Background" Value="{DynamicResource Studio.Surface}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Studio.Separator}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Studio.Hover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Studio.Foreground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Объединенная панель управления -->
            <RowDefinition Height="*"/>    <!-- Список логов -->
            <RowDefinition Height="Auto"/> <!-- Статусная строка -->
        </Grid.RowDefinitions>
        
        <!-- Объединенная панель управления -->
        <Border Grid.Row="0" Background="{DynamicResource Studio.Surface}" BorderBrush="{DynamicResource Studio.Separator}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                <!-- Первая группа: Фильтры по уровням логирования -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <ToggleButton IsChecked="{Binding IsTraceVisible}"
                                 Style="{StaticResource LogLevelToggleButtonFirstStyle}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 ToolTip="Trace">
                        <materialIcons:MaterialIcon Kind="TimelineTextOutline" Width="16" Height="16"/>
                    </ToggleButton>
                    
                    <ToggleButton IsChecked="{Binding IsDebugVisible}"
                                  Style="{StaticResource LogLevelToggleButtonStyle}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 ToolTip="Debug">
                        <materialIcons:MaterialIcon Kind="Bug" Width="16" Height="16"/>
                    </ToggleButton>
                    
                    <ToggleButton IsChecked="{Binding IsInfoVisible}"
                                 Style="{StaticResource LogLevelToggleButtonStyle}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 ToolTip="Info">
                        <materialIcons:MaterialIcon Kind="Information" Width="16" Height="16"/>
                    </ToggleButton>
                    
                    <ToggleButton IsChecked="{Binding IsWarningVisible}"
                                 Style="{StaticResource LogLevelToggleButtonStyle}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 ToolTip="Warning">
                        <materialIcons:MaterialIcon Kind="Warning" Width="16" Height="16"/>
                    </ToggleButton>
                    
                    <ToggleButton IsChecked="{Binding IsErrorVisible}"
                                 Style="{StaticResource LogLevelToggleButtonStyle}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 ToolTip="Error">
                        <materialIcons:MaterialIcon Kind="Error" Width="16" Height="16"/>
                    </ToggleButton>
                    
                    <ToggleButton IsChecked="{Binding IsFatalVisible}"
                                 Style="{StaticResource LogLevelToggleButtonStyle}"
                                 Foreground="{DynamicResource Studio.Foreground}"
                                 ToolTip="Fatal">
                        <materialIcons:MaterialIcon Kind="Skull" Width="16" Height="16"/>
                    </ToggleButton>
                    
                    <Button Command="{Binding SelectAllLevelsCommand}"
                            Style="{StaticResource LogLevelButtonStyle}"
                            ToolTip="Выбрать все">
                        <materialIcons:MaterialIcon Kind="CheckAll" Width="16" Height="16"/>
                    </Button>
                    
                    <Button Command="{Binding DeselectAllLevelsCommand}"
                            Style="{StaticResource LogLevelButtonLastStyle}"
                            ToolTip="Снять выбор">
                        <materialIcons:MaterialIcon Kind="CheckboxBlankOutline" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
                
                <!-- Вторая группа: Кнопки управления и поиск -->
                <StackPanel Orientation="Horizontal" Margin="10,2,0,2">
                    <!-- Кнопки управления -->
                    <Button Command="{Binding ClearLogsCommand}"
                            Style="{StaticResource LogLevelButtonStyle}"
                            ToolTip="Очистить все логи">
                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                    </Button>
                    
                    <Button Command="{Binding ExportLogsCommand}"
                            Style="{StaticResource LogLevelButtonStyle}"
                            ToolTip="Экспортировать логи в файл">
                        <materialIcons:MaterialIcon Kind="Export" Width="16" Height="16"/>
                    </Button>
                    
                    <Button Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource LogLevelButtonStyle}"
                            ToolTip="Сбросить все фильтры">
                        <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                    
                    <!-- Кнопка настроек -->
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource LogLevelButtonLastStyle}"
                            ToolTip="Настройки"
                            Click="SettingsButton_Click">
                        <materialIcons:MaterialIcon Kind="Cog" Width="16" Height="16"/>
                    </Button>
                    
                    <!-- Popup для настроек -->
                    <Popup x:Name="SettingsPopup"
                           PlacementTarget="{Binding ElementName=SettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource Studio.Surface}"
                                BorderBrush="{DynamicResource Studio.Separator}"
                                BorderThickness="1"
                                CornerRadius="3">

                            <StackPanel Orientation="Vertical" Margin="10">
                                <!-- Группа основных настроек -->
                                <TextBlock Text="Основные настройки" Foreground="{DynamicResource Studio.Foreground}" FontWeight="Bold" Margin="0,0,0,5"/>
                                
                                <!-- Настройка максимального количества записей -->
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Макс. записей:" Foreground="{DynamicResource Studio.Foreground}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               MinWidth="80"/>
                                    <TextBox Text="{Binding MaxDisplayedEntries, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80"
                                             Height="25"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Настройка автопрокрутки -->
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <CheckBox IsChecked="{Binding AutoScroll}"
                                              Content="Автопрокрутка"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Separator Margin="0,10"/>
                                
                                <!-- Группа информации -->
                                <TextBlock Text="Информация" Foreground="{DynamicResource Studio.Foreground}" FontWeight="Bold" Margin="0,0,0,5"/>
                                
                                <!-- Оптимизации -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="WPF виртуализация:" Foreground="{DynamicResource Studio.Foreground}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               MinWidth="100"/>
                                    <TextBlock Text="Включена"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Studio.Foreground}"/>
                                </StackPanel>
                                
                                <!-- Режим переработки -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Режим переработки:" Foreground="{DynamicResource Studio.Foreground}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               MinWidth="100"/>
                                    <TextBlock Text="Активен"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Studio.Foreground}"/>
                                </StackPanel>
                                
                                <!-- Батчевые обновления -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Батчевые обновления:" Foreground="{DynamicResource Studio.Foreground}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               MinWidth="100"/>
                                    <TextBlock Text="100ms"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Studio.ForegroundMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    
                    <Separator Margin="10,0"/>
                    
                    <!-- Поиск -->
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource Studio.Foreground}" Background="{DynamicResource Studio.SurfaceAlt}" CaretBrush="{DynamicResource Studio.Foreground}"
                             Width="150" Height="25" VerticalAlignment="Center"
                             ToolTip="Поиск по тексту сообщений"
                             FontFamily="{DynamicResource Studio.FontFamily}"/>
                </StackPanel>
            </WrapPanel>
        </Border>
        
        <!-- Список логов с виртуализацией -->
        <ListView Grid.Row="1" Foreground="{DynamicResource Studio.Foreground}"
                  ItemsSource="{Binding FilteredLogs}"
                  ItemContainerStyle="{StaticResource LogEntryItemStyle}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsContainerVirtualizable="True"
                  ScrollViewer.CanContentScroll="False"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  ScrollViewer.ScrollChanged="ListView_ScrollChanged"
                  x:Name="LogListView"
                  BorderThickness="0">
            
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource CustomGridViewColumnHeaderStyle}">
                    <!-- Колонка времени -->
                    <GridViewColumn Width="100">
                        <GridViewColumn.Header>
                            <TextBlock Text="Время" Foreground="{DynamicResource Studio.Foreground}" FontFamily="{DynamicResource Studio.FontFamily}"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Timestamp, Converter={StaticResource DateTimeToStringConverter}}"
                                         FontFamily="{DynamicResource Studio.FontFamily}"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         IsTabStop="False"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    
                    <!-- Колонка уровня -->
                    <GridViewColumn Width="60">
                        <GridViewColumn.Header>
                            <TextBlock Text="Уровень" Foreground="{DynamicResource Studio.Foreground}"
                                       FontFamily="{DynamicResource Studio.FontFamily}" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Level}"
                                         Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                         FontWeight="Bold"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         IsTabStop="False"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    
                    <!-- Колонка сообщения -->
                    <GridViewColumn>
                        <GridViewColumn.Header>
                            <TextBlock Text="Сообщение" Foreground="{DynamicResource Studio.Foreground}"
                                       FontFamily="{DynamicResource Studio.FontFamily}" />
                        </GridViewColumn.Header>
                        <GridViewColumn.Width>
                            <Binding RelativeSource="{RelativeSource AncestorType=ListView}"
                                     Path="ActualWidth"
                                     Converter="{StaticResource MessageColumnWidthConverter}"/>
                        </GridViewColumn.Width>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Message}"
                                         TextWrapping="Wrap"
                                         FontFamily="{DynamicResource Studio.FontFamily}"
                                         FontSize="11"
                                         Margin="2,0"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         IsTabStop="False"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        
        <!-- Статусная строка -->
        <Border Grid.Row="2" Background="{DynamicResource Studio.Surface}" BorderBrush="{DynamicResource Studio.Separator}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="1" 
                           Text="{Binding FilteredLogsCount, StringFormat='Отображено: {0}'}" Foreground="{DynamicResource Studio.ForegroundMuted}" 
                           Margin="5,3"
                           FontSize="11"
                           FontFamily="{DynamicResource Studio.FontFamily}"/>
                
                <TextBlock Grid.Column="2" 
                           Text="{Binding TotalLogsCount, StringFormat='Всего: {0}'}" Foreground="{DynamicResource Studio.ForegroundMuted}" 
                           Margin="15,3,5,3"
                           FontSize="11"
                           FontFamily="{DynamicResource Studio.FontFamily}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>