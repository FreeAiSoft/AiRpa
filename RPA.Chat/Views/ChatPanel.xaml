<UserControl x:Class="RPA.Chat.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             FontFamily="{DynamicResource Studio.FontFamily}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RPA.Chat.Controls"
             xmlns:conv="clr-namespace:RPA.Chat.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RPA.Chat;component/Themes/ChatTheme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:MarkdownToElementConverter x:Key="MarkdownToElement" />
            <conv:ModeBorderBrushConverter x:Key="ModeBorderBrushConverter" />

            <!-- Transparent icon button (toolbar / input / overlays) -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Stealth card button for history items: slightly lighter than the window background. -->
            <Style x:Key="HistoryCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Dark.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filled accent button -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Dark.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Material-style switch -->
            <Style x:Key="SwitchToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Track"
                                        Background="{DynamicResource Dark.ControlHover}"
                                        BorderBrush="{DynamicResource Dark.Border}"
                                        BorderThickness="1"
                                        CornerRadius="7" />
                                <Ellipse x:Name="Thumb" Width="10" Height="10"
                                         Fill="{DynamicResource Dark.MutedText}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource Dark.ControlPressed}" />
                                    <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Dark.Text}" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Dark.MutedText}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Dark.MutedText}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Thumb" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Outlined field styles -->
            <Style x:Key="OutlinedTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource Dark.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{DynamicResource Dark.Text}" />
            </Style>
            <!-- Composer input field: border takes the active mode accent while focused or hovered. -->
            <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource Dark.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{DynamicResource Dark.Text}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ModeBorderBrushConverter}">
                                        <Binding Path="DataContext.ModeAccentBrush" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="IsKeyboardFocused" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Border.BorderBrush>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OutlinedPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource Dark.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{DynamicResource Dark.Text}" />
            </Style>
            <Style x:Key="OutlinedComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--
                Явный стиль внутреннего ToggleButton «коробки» списка (рамка + стрелка).
                Без собственного Style на ToggleButton ложится неявный стиль MaterialDesign — это
                переключатель 34x18, из-за него рамка ComboBox сжималась по горизонтали, хотя сам
                ComboBox растянут по столбцу (окно настроек агента, вкладки API/General/Sound).
            -->
            <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Width" Value="Auto" />
                <!-- MinWidth="Auto" недопустим: LengthConverter возвращает double.NaN, а MinWidth не принимает NaN (падает Style.Seal). -->
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ClickMode" Value="Press" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Path x:Name="Arrow" Data="M 0 0 L 3 3 L 6 0"
                                      Stroke="{DynamicResource Dark.Text}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="8" Height="5"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OutlinedComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource Dark.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dark.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource OutlinedComboBoxItemStyle}" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboBoxToggleButtonStyle}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="6,4,24,4"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide"
                                       StaysOpen="False">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource Dark.Panel}"
                                            BorderBrush="{DynamicResource Dark.Border}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Dark.SubtleText}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,8,0,2" />
            </Style>

            <!-- Main tab (icon 44x44) -->
            <Style x:Key="MainTabItemStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="AccentHighlight" Background="{DynamicResource Dark.Primary}" Opacity="0" />
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="AccentHighlight" Property="Opacity" Value="0.2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Settings nav item (icon 44x44) -->
            <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="AccentHighlight" Background="{DynamicResource Dark.Primary}" Opacity="0" />
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dark.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="AccentHighlight" Property="Opacity" Value="0.2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Плоский скролл 10px: та же ширина, что у глобального стиля студии (Themes\StudioScrollBar.xaml). -->
            <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="MaxWidth" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bd" Background="{DynamicResource Dark.Border}" CornerRadius="5" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chat.ScrollThumbHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chat.ScrollThumbDragging}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" />
                                    <Setter Property="Height" Value="10" />
                                    <Setter Property="MinHeight" Value="10" />
                                    <Setter Property="MaxHeight" Value="10" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl Background="{DynamicResource Dark.Window}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" />
                    <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ============ Chat tab ============ -->
        <TabItem Style="{StaticResource MainTabItemStyle}" ToolTip="Chat">
            <TabItem.Header>
                <materialIcons:MaterialIcon>
                    <materialIcons:MaterialIcon.Style>
                        <Style TargetType="materialIcons:MaterialIcon">
                            <Setter Property="Width" Value="24" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Foreground" Value="{DynamicResource Dark.Primary}" />
                            <Setter Property="Kind" Value="MessageOutline" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                    <Setter Property="Kind" Value="Message" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialIcons:MaterialIcon.Style>
                </materialIcons:MaterialIcon>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" MinHeight="90" />
                </Grid.RowDefinitions>

                <!-- Toolbar + notice + commit -->
                <StackPanel Grid.Row="0" Margin="8,6,8,0">
                    <controls:NotificationBanner Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}"
                                                 Message="{Binding NoticeMessage}" Kind="{Binding NoticeKind}"
                                                 CloseRequested="OnNoticeClose" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                Command="{Binding NewChatCommand}" ToolTip="New chat">
                            <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                Command="{Binding ShowHistoryCommand}" ToolTip="History">
                            <materialIcons:MaterialIcon Kind="TimelineTextOutline" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                Command="{Binding CommitCommand}" ToolTip="Commit">
                            <materialIcons:MaterialIcon Kind="SourceCommit" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                Command="{Binding SendErrorsCommand}" ToolTip="Send errors to chat">
                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="0,0,4,0"
                                Command="{Binding CopyConversationCommand}" ToolTip="Copy all chat messages">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                    </WrapPanel>

                    <!-- Commit panel -->
                    <Border Margin="0,6,0,0" BorderThickness="1" BorderBrush="{DynamicResource Dark.Border}"
                            Background="{DynamicResource Dark.Panel}" CornerRadius="2" Padding="8,6"
                            Visibility="{Binding IsCommitOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <controls:NotificationBanner Kind="Warning" Message="{Binding CommitWarningMessage}"
                                                         Visibility="{Binding HasCommitWarning, Converter={StaticResource BoolToVis}}"
                                                         CloseRequested="OnCommitWarningClose" />
                            <controls:NotificationBanner Kind="{Binding CommitResultKind}" Message="{Binding CommitResultMessage}"
                                                         Visibility="{Binding HasCommitResult, Converter={StaticResource BoolToVis}}"
                                                         CloseRequested="OnCommitResultClose" />
                            <StackPanel Visibility="{Binding IsCommitEditorVisible, Converter={StaticResource BoolToVis}}">
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto" Margin="0,4,0,6"
                                         Style="{StaticResource OutlinedTextBoxStyle}"
                                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Commit" Command="{Binding CommitSendCommand}" Padding="10,2" />
                                    <Button Content="Auto-generate message" Command="{Binding CommitAutoGenerateCommand}" Padding="10,2" Margin="8,0,0,0" />
                                    <Button Content="Close" Command="{Binding CommitCloseCommand}" Padding="10,2" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding CommitStatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource Dark.SubtleText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Conversation / history -->
                <Grid Grid.Row="1" Margin="8,4,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:PinnedChatMessageControl Grid.Row="0"
                                                       MessageText="{Binding PinnedMessageText}"
                                                       ProgressMaximum="1"
                                                       ProgressValue="{Binding ContextFillFraction, Mode=OneWay}"
                                                       ContextText="{Binding ContextUsageText}"
                                                       Visibility="{Binding IsPinnedMessageVisible, Converter={StaticResource BoolToVis}}"
                                                       CloseRequested="OnPinnedClose" />
                    <controls:ChatMessagesControl x:Name="ChatMessages" Grid.Row="1"
                                                  ItemsSource="{Binding ChatMessages}"
                                                  Visibility="{Binding IsConversationView, Converter={StaticResource BoolToVis}}" />

                    <!-- History -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsConversationView, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" HorizontalAlignment="Right"
                                    Command="{Binding ClearHistoryCommand}" ToolTip="Clear history">
                                <materialIcons:MaterialIcon Kind="Broom" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Chat history" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,16,0,8" Foreground="{DynamicResource Dark.Text}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="80*" />
                                <ColumnDefinition Width="10*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding Conversations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Button Style="{StaticResource HistoryCardButtonStyle}" Padding="10,8,32,8"
                                                        Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Preview}" Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Dark.MutedText}" />
                                                        <TextBlock Text="{Binding DisplayDate}" Margin="0,4,0,0" Foreground="{DynamicResource Dark.SubtleText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                        Style="{StaticResource IconButtonStyle}" Width="22" Height="22" ToolTip="Delete chat"
                                                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="Delete" Width="14" Height="14" Foreground="{DynamicResource Dark.Text}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="2" Margin="8,0" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Dark.Border}" />
                <!-- Composer -->
                <Grid Grid.Row="3" Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="35" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status -->
                    <Grid Grid.Row="0" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource Dark.SubtleText}" />
                    </Grid>

                    <!-- Attachments -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Attachments}"
                                  Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Dark.Control}" BorderBrush="{DynamicResource Dark.Border}"
                                        BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" MaxWidth="280"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Dark.Text}" FontSize="13" />
                                        <Button Content="✕" Margin="6,0,0,0" Padding="4,0" BorderThickness="0" Background="Transparent"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Input -->
                    <Grid Grid.Row="2" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" FontSize="14"
                                 VerticalScrollBarVisibility="Auto" MinHeight="35" VerticalContentAlignment="Top"
                                 Style="{StaticResource ComposerTextBoxStyle}"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnInputPreviewKeyDown">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
                            </TextBox.Resources>
                        </TextBox>
                        <controls:BottomUpWrapPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6,0,0,0">
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding ClearInputCommand}" ToolTip="Clear message">
                                <materialIcons:MaterialIcon Kind="Broom" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding AttachFilesCommand}" ToolTip="Attach image or file">
                                <materialIcons:MaterialIcon Kind="Paperclip" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding ToggleRecordingCommand}" ToolTip="{Binding MicToolTip}" Opacity="{Binding MicLevel}">
                                <materialIcons:MaterialIcon Kind="Microphone" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding StopCommand}" ToolTip="Cancel"
                                    Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                                <materialIcons:MaterialIcon Kind="Stop" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding SendCommand}" ToolTip="Send (Enter)">
                                <materialIcons:MaterialIcon Kind="Send" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                        </controls:BottomUpWrapPanel>
                    </Grid>
                    <!-- Mode + actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Dark.SubtleText}" />
                        <controls:SegmentedToggle ItemsSource="{Binding ModeItems}" SelectedValue="{Binding ModeName, Mode=TwoWay}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="10,0,0,0" VerticalAlignment="Center"
                                Command="{Binding CompactNowCommand}" ToolTip="Summarize the conversation to free context space">
                            <materialIcons:MaterialIcon Kind="Compress" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding UpdateMemoryCommand}" ToolTip="Ask the agent to update the project memory bank">
                            <materialIcons:MaterialIcon Kind="Database" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding PermissionsCommand}" ToolTip="Configure agent permissions (read files, edit files, execute commands, web fetch)">
                            <materialIcons:MaterialIcon Kind="ShieldLockOutline" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DocsCommand}" ToolTip="Open the documentation">
                            <materialIcons:MaterialIcon Kind="BookOpenPageVariant" Width="18" Height="18" Foreground="{DynamicResource Dark.Text}" />
                        </Button>
                        <Button Content="Do it!!!" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DoItCommand}" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="Send 'Do it!!!' to the agent" />
                    </StackPanel>
                </Grid>
                <!-- Permissions overlay -->
                <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource Dark.Panel}" BorderBrush="{DynamicResource Dark.Border}"
                        BorderThickness="1" CornerRadius="2" Padding="12,10"
                        Visibility="{Binding IsPermissionsOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260" TextElement.FontSize="14">
                        <TextBlock Text="Agent permissions" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource Dark.Text}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Settings.AllowReadFiles, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Read files" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Settings.AllowEditFiles, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Edit files" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Settings.AllowExecuteCommand, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Execute command" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Settings.AllowWebFetch, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Web fetch" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Settings.AllowSubagents, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="Sub-agents" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                        </StackPanel>
                        <Button Content="Close" Command="{Binding PermissionsCloseCommand}" Margin="0,12,0,0" Padding="10,3" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Docs overlay -->
                <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource Dark.Panel}" BorderBrush="{DynamicResource Dark.Border}"
                        BorderThickness="1" CornerRadius="2" Padding="12,10"
                        Visibility="{Binding IsDocsOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Documentation" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource Dark.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Home" Command="{Binding DocsHomeCommand}" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Close" Command="{Binding DocsCloseCommand}">
                                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Dark.Text}" />
                            </Button>
                        </Grid>
                        <ScrollViewer x:Name="DocsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding DocsContent, Converter={StaticResource MarkdownToElement}}" Margin="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <!-- ============ Settings tab ============ -->
        <TabItem Style="{StaticResource MainTabItemStyle}" ToolTip="Settings">
            <TabItem.Header>
                <materialIcons:MaterialIcon>
                    <materialIcons:MaterialIcon.Style>
                        <Style TargetType="materialIcons:MaterialIcon">
                            <Setter Property="Width" Value="24" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Foreground" Value="{DynamicResource Dark.Primary}" />
                            <Setter Property="Kind" Value="CogOutline" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                    <Setter Property="Kind" Value="Cog" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialIcons:MaterialIcon.Style>
                </materialIcons:MaterialIcon>
            </TabItem.Header>

            <Grid DataContext="{Binding SettingsViewModel}" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="SettingsNav" Grid.Column="0" Grid.Row="0"
                         SelectedIndex="{Binding SettingsSectionIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}" Margin="0,0,8,0"
                         Background="Transparent" BorderThickness="0">
                    <ListBoxItem ToolTip="API">
                        <materialIcons:MaterialIcon>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                                    <Setter Property="Kind" Value="NetworkOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Kind" Value="Network" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="General">
                        <materialIcons:MaterialIcon>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                                    <Setter Property="Kind" Value="CogOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Kind" Value="Cog" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Sound">
                        <materialIcons:MaterialIcon>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                                    <Setter Property="Kind" Value="MicrophoneOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Kind" Value="Microphone" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Timeouts">
                        <materialIcons:MaterialIcon>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                                    <Setter Property="Kind" Value="TimerOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Kind" Value="Timer" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Gallery">
                        <materialIcons:MaterialIcon>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                                    <Setter Property="Kind" Value="ViewGridOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Kind" Value="ViewGrid" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Proxy">
                        <materialIcons:MaterialIcon>
                            <materialIcons:MaterialIcon.Style>
                                <Style TargetType="materialIcons:MaterialIcon">
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dark.Text}" />
                                    <Setter Property="Kind" Value="ProxyOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Kind" Value="Proxy" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialIcons:MaterialIcon.Style>
                        </materialIcons:MaterialIcon>
                    </ListBoxItem>
                </ListBox>

                <TabControl Grid.Column="1" Grid.Row="0" SelectedIndex="{Binding SelectedIndex, ElementName=SettingsNav}"
                            Background="Transparent" BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <!-- API -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="API" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource Dark.Text}" />
                                <TextBlock Text="Base URL" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="API key" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.Model, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Temperature" Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Slider Width="200" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            SmallChange="0.1" LargeChange="0.2" Value="{Binding Data.Temperature, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Data.Temperature, StringFormat={}{0:0.0}}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Width="40" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                                <TextBlock Text="Context window (tokens)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ContextWindowSize, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Input price ($/1M tokens)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.InputPricePerMillion, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Cache-hit price ($/1M tokens)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.CacheHitPricePerMillion, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Output price ($/1M tokens)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.OutputPricePerMillion, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Tool calling" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource OutlinedComboBoxStyle}" ItemsSource="{Binding ToolCallingModeOptions}"
                                          SelectedValue="{Binding Data.ToolCallingMode, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Data.UseToolRole, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Use 'tool' role for tool results" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- General -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="General" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource Dark.Text}" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Data.AutoCompact, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Auto-compact (summarize)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                                <TextBlock Text="Compact threshold (0..1)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.CompactThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Reserve fraction (0..1)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ReserveFraction, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Keep recent messages" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.KeepRecentMessages, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Tool result max chars" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ToolResultMaxChars, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Max agent iterations" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.MaxIterations, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Memory bank" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource OutlinedComboBoxStyle}" ItemsSource="{Binding MemoryBankModeOptions}"
                                          SelectedValue="{Binding Data.MemoryBankMode, Mode=TwoWay}" />
                                <TextBlock Text="User name" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.UserName, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Data.AddressByName, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Address me by name" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                                <TextBlock Text="Skills directory" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.SkillsPath, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Data.AllowSubagents, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Enable sub-agents (spawn_agent)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                                <TextBlock Text="Sub-agent max iterations" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.SubagentMaxIterations, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Sub-agent max depth" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.SubagentMaxDepth, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Sound -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="Sound" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource Dark.Text}" />
                                <TextBlock Text="Speech recognition" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Style="{StaticResource OutlinedComboBoxStyle}" ItemsSource="{Binding SpeechToTextProviderOptions}"
                                          SelectedValue="{Binding Data.SpeechToTextProvider, Mode=TwoWay}" />
                                <TextBlock Text="Whisper STT model" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.SpeechToTextModel, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Speech language" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.SpeechToTextLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Vosk model directory" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.VoskModelPath, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Data.SpeechAutoSend, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Auto-send voice input" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Timeouts -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="Timeouts" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource Dark.Text}" />
                                <TextBlock Text="Request timeout (s)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Retry budget (min)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.RetryTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Retry base delay (s)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.RetryBaseDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Retry max delay (s)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.RetryMaxDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Gallery -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="Gallery" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource Dark.Text}" />
                                <TextBlock Text="Primary prompt (pinned)" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource Dark.Text}" />
                                <controls:PinnedChatMessageControl MessageText="You: Fix the null-check in the parser and add a regression test."
                                                                   ProgressValue="42"
                                                                   ContextText="Context window: 12.4k / 200k" />
                                <TextBlock Text="Notification banners" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource Dark.Text}" />
                                <controls:NotificationBanner Kind="Trace" Message="Trace sample: most verbose level." Margin="0,0,0,8" />
                                <controls:NotificationBanner Kind="Info" Message="Info sample: informational message." Margin="0,0,0,8" />
                                <controls:NotificationBanner Kind="Success" Message="Success sample: action completed." Margin="0,0,0,8" />
                                <controls:NotificationBanner Kind="Warning" Message="Warning sample: shows copy and send-to-chat." Margin="0,0,0,8" />
                                <controls:NotificationBanner Kind="Error" Message="Error sample: shows copy and send-to-chat." Margin="0,0,0,8" />
                                <TextBlock Text="Chat messages" FontWeight="SemiBold" Margin="0,16,0,8" Foreground="{DynamicResource Dark.Text}" />
                                <controls:ChatMessagesControl x:Name="GalleryChatMessages" MaxHeight="480" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Proxy -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="Proxy" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" Foreground="{DynamicResource Dark.Text}" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource SwitchToggleButtonStyle}" IsChecked="{Binding Data.ProxyEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Route requests through a proxy" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Dark.Text}" />
                                </StackPanel>
                                <TextBlock Text="Host" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ProxyHost, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Port" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ProxyPort, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ProxyUsername, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Style="{StaticResource OutlinedTextBoxStyle}" Text="{Binding Data.ProxyPassword, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}" ToolTip="Save settings">
                        <materialIcons:MaterialIcon Kind="ContentSaveCogOutline" Width="20" Height="20" Foreground="{DynamicResource Dark.Primary}" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                            Command="{Binding DataContext.RefreshPromptsCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                            ToolTip="Update prompts">
                        <materialIcons:MaterialIcon Kind="Reload" Width="20" Height="20" Foreground="{DynamicResource Dark.Primary}" />
                    </Button>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>














