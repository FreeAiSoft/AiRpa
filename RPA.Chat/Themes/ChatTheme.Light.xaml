<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Light chat theme. Те же ключи, что и в ChatTheme.Dark.xaml, значения — светлые токены палитры
        (docs\Vs2026_Theme_Plan.md, §2). Акцентных цветов нет; красный (#E81123) — только семантика ошибки.
    -->
    <SolidColorBrush x:Key="Dark.Window" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Dark.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Dark.Control" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Dark.ControlHover" Color="#EAEAEA" />
    <SolidColorBrush x:Key="Dark.ControlPressed" Color="#E4E4E4" />
    <SolidColorBrush x:Key="Dark.Border" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Dark.Text" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Dark.SubtleText" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Dark.MutedText" Color="#5F6368" />
    <SolidColorBrush x:Key="Dark.Accent" Color="#E4E4E4" />
    <SolidColorBrush x:Key="Dark.ErrorText" Color="#E81123" />
    <SolidColorBrush x:Key="Dark.Primary" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Chat.UserBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Chat.UserBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Chat.LastActBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Chat.LastActBackground" Color="#26E4E4E4" />
    <SolidColorBrush x:Key="Chat.LastPlanBorder" Color="#E4E4E4" />
    <SolidColorBrush x:Key="Chat.LastPlanBackground" Color="#1AEAEAEA" />
    <SolidColorBrush x:Key="Question.OptionBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Question.AnswerBorder" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Chat.ToolBlockedBorder" Color="#E81123" />
    <SolidColorBrush x:Key="Chat.ToolBlockedBackground" Color="#26E81123" />
    <SolidColorBrush x:Key="Chat.ErrorBorder" Color="#E81123" />
    <SolidColorBrush x:Key="Chat.ErrorBackground" Color="#26E81123" />
    <SolidColorBrush x:Key="Chat.CompactionBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Chat.CompactionBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Chat.ModeSwitchBorder" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Chat.ModeSwitchBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Chat.ReasoningText" Color="#5F6368" />
    <SolidColorBrush x:Key="Chat.ScrollThumb" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Chat.ScrollThumbHover" Color="#5F6368" />
    <SolidColorBrush x:Key="Chat.ScrollThumbDragging" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Commit.SuccessBackground" Color="#2E7D32" />
    <SolidColorBrush x:Key="Commit.ErrorBackground" Color="#E65100" />
    <SolidColorBrush x:Key="Code.Background" Color="#FFFFFF" />
</ResourceDictionary>
