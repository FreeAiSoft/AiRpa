<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark chat theme. Все значения — нейтральные токены палитры студии (docs\Vs2026_Theme_Plan.md, §2):
        фон и состояния передаются только яркостью, акцентных цветов нет. Красный (#E81123) — единственное
        исключение и используется исключительно как семантика ошибки. В студии эти значения на лету
        перекрываются мостом RPA.Chat.Themes.ChatStudioBridge из ключей Studio.*.
    -->
    <SolidColorBrush x:Key="Dark.Window" Color="#272727" />
    <SolidColorBrush x:Key="Dark.Panel" Color="#272727" />
    <SolidColorBrush x:Key="Dark.Control" Color="#2E2E2F" />
    <SolidColorBrush x:Key="Dark.ControlHover" Color="#333638" />
    <SolidColorBrush x:Key="Dark.ControlPressed" Color="#404046" />
    <SolidColorBrush x:Key="Dark.Border" Color="#48484F" />
    <SolidColorBrush x:Key="Dark.Text" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Dark.SubtleText" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Dark.MutedText" Color="#9DA0A6" />
    <SolidColorBrush x:Key="Dark.Accent" Color="#404046" />
    <SolidColorBrush x:Key="Dark.ErrorText" Color="#E81123" />
    <SolidColorBrush x:Key="Dark.Primary" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Chat.UserBorder" Color="#48484F" />
    <SolidColorBrush x:Key="Chat.UserBackground" Color="#2E2E2F" />
    <SolidColorBrush x:Key="Chat.LastActBorder" Color="#48484F" />
    <SolidColorBrush x:Key="Chat.LastActBackground" Color="#26404046" />
    <SolidColorBrush x:Key="Chat.LastPlanBorder" Color="#373737" />
    <SolidColorBrush x:Key="Chat.LastPlanBackground" Color="#1A333638" />
    <SolidColorBrush x:Key="Question.OptionBorder" Color="#48484F" />
    <SolidColorBrush x:Key="Question.AnswerBorder" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Chat.ToolBlockedBorder" Color="#E81123" />
    <SolidColorBrush x:Key="Chat.ToolBlockedBackground" Color="#26E81123" />
    <SolidColorBrush x:Key="Chat.ErrorBorder" Color="#E81123" />
    <SolidColorBrush x:Key="Chat.ErrorBackground" Color="#26E81123" />
    <SolidColorBrush x:Key="Chat.CompactionBorder" Color="#48484F" />
    <SolidColorBrush x:Key="Chat.CompactionBackground" Color="#2E2E2F" />
    <SolidColorBrush x:Key="Chat.ModeSwitchBorder" Color="#48484F" />
    <SolidColorBrush x:Key="Chat.ModeSwitchBackground" Color="#2E2E2F" />
    <SolidColorBrush x:Key="Chat.ReasoningText" Color="#9DA0A6" />
    <SolidColorBrush x:Key="Chat.ScrollThumb" Color="#48484F" />
    <SolidColorBrush x:Key="Chat.ScrollThumbHover" Color="#9DA0A6" />
    <SolidColorBrush x:Key="Chat.ScrollThumbDragging" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Commit.SuccessBackground" Color="#2E7D32" />
    <SolidColorBrush x:Key="Commit.ErrorBackground" Color="#E65100" />
    <SolidColorBrush x:Key="Code.Background" Color="#272727" />
</ResourceDictionary>
