<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RPA.Chat</RootNamespace>
    <AssemblyName>RPA.Chat</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Material.Icons.WPF" Version="2.4.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- Единая версия пакета во всём решении: 4.5.2 даёт сборку 4.2.0.0, а студия перенаправляет
         привязку на 4.2.0.1 (пакет 4.5.4). Разные копии одной сборки в папке приложения роняли
         дизайнер WF (FileLoadException, HRESULT 0x80131040) при перечислении пространств имён. -->
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme resource dictionaries (no x:Class): compiled to BAML and swapped at runtime. -->
    <Page Remove="Themes\**\*.xaml" />
    <None Remove="Themes\**\*.xaml" />
    <Page Include="Themes\ChatTheme.Dark.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Themes\ChatTheme.Light.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Mermaid.js bundled as an embedded resource and read at runtime by MermaidDiagramControl. -->
    <EmbeddedResource Include="Assets\mermaid.min.js">
      <LogicalName>RPA.Chat.Assets.mermaid.min.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyWebView2LoaderToOutput" AfterTargets="Build">
    <!-- The WebView2 NuGet package only drops the native loader under runtimes\ for this
         SDK-style net48 project. Copy the x64 loader next to the managed assemblies so the
         studio (and F5 debug) can find it. -->
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
